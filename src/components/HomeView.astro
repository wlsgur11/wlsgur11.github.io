---
import { getCollection } from 'astro:content';
import BaseHead from './BaseHead.astro';
import Footer from './Footer.astro';
import FormattedDate from './FormattedDate.astro';
import Header from './Header.astro';
import { PROFILE, SITE_DESCRIPTION, tabTitle } from '../consts';
import { type Lang, localize, useTranslations } from '../i18n';

interface Props {
	lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const en = lang === 'en';
const pick = (ko: string, e?: string) => (en && e ? e : ko);
const L = (o: { ko: string; en: string }) => (en ? o.en : o.ko);

const hero = {
	headline: {
		ko: '제한된 자원에서 측정하고 최적화하는 백엔드 개발자',
		en: 'A backend engineer who measures and optimizes under tight resources',
	},
	eyebrow: {
		ko: '부산대 AI융합교육원 연구원',
		en: 'Researcher, PNU AI Convergence Education Institute',
	},
	sub: {
		ko: '실서비스 온라인 저지 Code Place의 인프라와 AI 조교를 운영합니다.',
		en: 'Running the infrastructure and AI tutor for Code Place, a production online judge.',
	},
};

const introParas = [
	{
		ko: '부산대학교 정보컴퓨터공학부를 졸업하고, 백엔드와 인프라를 중심으로 개발합니다. 단순 구현보다 서비스가 실제 환경에서 어떻게 동작하고 유지되는지에 관심이 많습니다.',
		en: 'I graduated in Computer Science at Pusan National University and work mainly on backend and infrastructure. I care less about just making things work and more about how a service behaves and holds up in production.',
	},
	{
		ko: '부산대 AI융합교육원 연구원으로 교육원 개발 업무를 맡고 있습니다. 실서비스 OJ "Code Place"의 기능 개발과 인프라 운영을 담당하며, K3s 환경의 운영 문제와 vLLM 기반 AI 조교를 다루고, 문제는 증상이 아니라 근본 원인까지 추적합니다.',
		en: 'I am a researcher at PNU’s AI Convergence Education Institute, responsible for the institute’s software development. I build features and run the infrastructure for "Code Place", a production Online Judge. I handle operational issues on k3s and a vLLM-based AI tutor, and I chase problems down to the root cause, not the symptom.',
	},
];

const allPosts = (await getCollection('blog', (p) => !p.data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const posts = allPosts.slice(0, 5);

// 측정값 띠. 수치는 각 글 본문에서 확인한 값만 쓴다.
//  2.89: load-test 글 "30명까지는 목표인 3초 안(2.891초)에 들어왔다."
//  4.6 : prefix-cache 글 "같은 30명인데 첫 토큰이 312ms에서 1,435ms로 4.6배 뛰었다."
//  398 : crashloop 글 "운영 백엔드 파드가 재시작 398회를 기록했지만 앱 로그는 정상 기동이었다."
const metrics = [
	{
		value: '2.89',
		unit: { ko: '초', en: 's' },
		slug: 'code-place-ai-tutor-load-test',
		desc: {
			ko: '동접 30명에서 AI 조교 평균 응답 시간, 실패 0건',
			en: 'Average AI-tutor response at 30 concurrent users, zero failures',
		},
	},
	{
		value: '4.6',
		unit: { ko: '배', en: '×' },
		slug: 'code-place-ai-tutor-prefix-cache',
		desc: {
			ko: 'prefix cache 유무로 갈린 첫 토큰 시간(TTFT), 312ms 대 1,435ms',
			en: 'Time to first token with and without prefix cache, 312 ms vs 1,435 ms',
		},
	},
	{
		value: '398',
		unit: { ko: '회', en: 'restarts' },
		slug: 'code-place-crashloop-398',
		desc: {
			ko: 'probe 설정 산술로 원인을 좁힌 운영 파드 재시작 횟수',
			en: 'Production pod restarts, narrowed to the cause by matching probe arithmetic',
		},
	},
].filter((m) => allPosts.some((p) => p.id === m.slug));

const projects = (await getCollection('projects', (p) => !p.data.draft))
	.filter((p) => p.data.featured)
	.sort((a, b) => a.data.order - b.data.order);

// 프로젝트 slug -> 로고/모노그램 매핑 (정사각 로고 없으면 mark로 폴백)
const projMark: Record<string, string> = { 'code-place': 'CP' };

const experience = [
	{
		mark: 'AI',
		logo: '/images/logos/pnu.png',
		org: { ko: '부산대학교 AI융합교육원', en: 'PNU AI Convergence Education Institute' },
		badge: { ko: '운영', en: 'Ops' },
		period: { ko: '2026.02 - 현재', en: '2026.02 - present' },
		role: {
			ko: '연구원 (2026.08 - 현재) | SW조교 (2026.02 - 2026.07)',
			en: 'Researcher (2026.08 - present) | SW Assistant (2026.02 - 2026.07)',
		},
		desc: {
			ko: '교육원 개발 업무를 담당. 실서비스 온라인 저지 "Code Place"의 기능 개발과 인프라 운영을 맡아 3인 개발팀을 리딩하고, 멀티 노드 K3s 환경의 운영 문제를 해결하며 로컬 LLM 기반 AI 조교를 기획, 개발했습니다.',
			en: 'Responsible for the institute’s software development. Own feature development and infrastructure for "Code Place", a production Online Judge. Lead a 3-person team, resolve operational issues on a multi-node K3s cluster, and built a local-LLM AI teaching assistant.',
		},
	},
	{
		mark: 'LL',
		logo: '/images/logos/pnu.png',
		org: { ko: 'PNU Mini Bootcamp (멋쟁이사자처럼)', en: 'PNU Mini Bootcamp (LikeLion)' },
		badge: { ko: '부트캠프', en: 'Bootcamp' },
		period: { ko: '2024 - 2025', en: '2024 - 2025' },
		role: { ko: '수료 (BE / FE)', en: 'Completed (BE / FE)' },
		desc: {
			ko: 'FastAPI, Redis, Spring Boot, Docker 기반 백엔드/인프라를 실습하며 총 230시간을 이수했습니다.',
			en: 'Practiced backend and infra with FastAPI, Redis, Spring Boot, and Docker across 230 hours.',
		},
	},
];

const education = [
	{
		mark: 'PNU',
		logo: '/images/logos/pnu.png',
		school: { ko: '부산대학교 정보컴퓨터공학부', en: 'Pusan National University, Computer Science' },
		period: { ko: '2023.03 - 2026.02', en: '2023.03 - 2026.02' },
		role: { ko: '졸업', en: 'B.S.' },
	},
];

const stack = [
	{ group: 'Back-end', items: ['Python', 'Java', 'FastAPI', 'Spring Boot', 'Django / DRF', 'Node.js'] },
	{ group: 'Front-end', items: ['JavaScript', 'TypeScript', 'Dart', 'React', 'Vue', 'Flutter'] },
	{ group: 'Database & Cache', items: ['PostgreSQL', 'Redis', 'MySQL', 'SQLite'] },
	{ group: 'Infrastructure', items: ['Kubernetes (K3s)', 'Longhorn', 'Harbor', 'Docker', 'GitHub Actions'] },
	{ group: 'AI / LLM', items: ['vLLM', 'Ollama', 'Qwen', 'Locust'] },
];

const awards = [
	{
		title: { ko: '제6회 PNU 창의융합SW해커톤', en: '6th PNU SW Hackathon' },
		meta: { ko: '2025.08 | 팀', en: '2025.08 | Team' },
		result: { ko: '장려상 / 소프트웨어융합교육원장상', en: 'Encouragement Award' },
	},
	{
		title: { ko: 'PNU 정보컴퓨터공학부 아이디어톤', en: 'PNU CSE Ideathon' },
		meta: { ko: '2024.12 | 팀', en: '2024.12 | Team' },
		result: { ko: '3등 / 학과장상', en: '3rd Place' },
	},
	{
		title: { ko: '제3회 PNU 메디컬 해커톤', en: '3rd PNU Medical Hackathon' },
		meta: { ko: '2024.11 | 팀', en: '2024.11 | Team' },
		result: { ko: '우수상 / 산학협력본부장상', en: 'Excellence Award' },
	},
];

const certs = en
	? [
			['Engineer Information Processing', '2025.09'],
			['SQLD', '2024.06'],
			['Network Administrator Lv.2', '2022.10'],
			['Computer Specialist Lv.2', '2022.06'],
			['OPIc IM2', '2025.02'],
			['Korean History Lv.3', '2025.10'],
		]
	: [
			['정보처리기사', '2025.09'],
			['SQLD', '2024.06'],
			['네트워크관리사 2급', '2022.10'],
			['컴퓨터활용능력 2급', '2022.06'],
			['OPIc IM2', '2025.02'],
			['한국사능력검정 3급', '2025.10'],
		];
---

<!doctype html>
<html lang={lang}>
	<head>
		<BaseHead title={tabTitle('홈')} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="home">
			<!-- HERO: 텍스트 요소 4개 (eyebrow, 헤드라인, 서브, 연락처) + 프로필 -->
			<section class="hero wrap">
				<div class="hero-text">
					<p class="eyebrow" data-hero>{en ? PROFILE.nameEn : PROFILE.name} | {L(hero.eyebrow)}</p>
					<h1 data-hero>{L(hero.headline)}</h1>
					<p class="sub" data-hero>{L(hero.sub)}</p>
					<nav class="contact" data-hero>
						<a href={PROFILE.github} target="_blank" rel="noopener">
							<svg viewBox="0 0 16 16" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg>{PROFILE.githubHandle}</a>
						<a href={`mailto:${PROFILE.email}`}>
							<svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><rect x="1.5" y="3" width="13" height="10" rx="1.5"/><path d="M2 4l6 4.5L14 4"/></svg>Email</a>
						<a href={PROFILE.instagram} target="_blank" rel="noopener">
							<svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><rect x="1.5" y="1.5" width="13" height="13" rx="4"/><circle cx="8" cy="8" r="3.2"/><circle cx="12" cy="4" r="0.55" fill="currentColor" stroke="none"/></svg>{PROFILE.instagramHandle}</a>
					</nav>
				</div>
				<div class="portrait">
					<img src="/images/profile.png" alt={PROFILE.name} width="896" height="1060" />
				</div>
			</section>

			<!-- 측정값 띠 -->
			{
				metrics.length > 0 && (
					<section class="band" data-band aria-label={en ? 'Measured results' : '측정한 결과'}>
						<div class="wrap band-grid">
							{metrics.map((m) => (
								<a class="metric" href={localize(`/blog/${m.slug}/`, lang)}>
									<span class="figure">
										<span class="num" data-count={m.value} style={`--len:${m.value.length}`}>
											{m.value}
										</span>
										<span class="unit">{L(m.unit)}</span>
									</span>
									<span class="metric-desc">{L(m.desc)}</span>
									<span class="metric-link">{t('viewDetail')}</span>
								</a>
							))}
						</div>
					</section>
				)
			}

			<!-- 소개 -->
			<section class="about wrap" aria-label={t('aboutTitle')}>
				{introParas.map((p) => <p>{L(p)}</p>)}
			</section>

			<!-- 경험 + 학력: 타임라인 행 -->
			<section class="wrap block">
				<div class="sec-head"><h2>{en ? 'Experience' : '경험'}</h2></div>
				<ol class="timeline">
					{
						experience.map((e) => (
							<li class="tl-row" data-reveal>
								<span class="tl-when">{L(e.period)}</span>
								<div class="tl-what">
									<div class="tl-head">
										{e.logo ? (
											<img class="tl-logo" src={e.logo} alt="" width="28" height="28" />
										) : (
											<span class="tl-logo mono">{e.mark}</span>
										)}
										<h3>{L(e.org)}</h3>
										<span class="badge">{L(e.badge)}</span>
									</div>
									<p class="tl-role">{L(e.role)}</p>
									<p class="tl-desc">{L(e.desc)}</p>
								</div>
							</li>
						))
					}
				</ol>
				<h3 class="sub-head">{en ? 'Education' : '학력'}</h3>
				<ol class="timeline">
					{
						education.map((e) => (
							<li class="tl-row" data-reveal>
								<span class="tl-when">{L(e.period)}</span>
								<div class="tl-what">
									<div class="tl-head">
										{e.logo ? (
											<img class="tl-logo" src={e.logo} alt="" width="28" height="28" />
										) : (
											<span class="tl-logo mono">{e.mark}</span>
										)}
										<h3>{L(e.school)}</h3>
									</div>
									<p class="tl-role">{L(e.role)}</p>
								</div>
							</li>
						))
					}
				</ol>
			</section>

			<!-- 대표 프로젝트: 2열, 개수가 홀수면 첫 카드가 전체 폭 -->
			<section class="wrap block">
				<div class="sec-head">
					<h2>{en ? 'Featured projects' : '대표 프로젝트'}</h2>
					<a href={localize('/projects', lang)}>{t('viewAll')}</a>
				</div>
				<div class="feat-grid">
					{
						projects.map((p) => (
							<a class="feat" href={localize(`/projects/${p.id}/`, lang)} data-reveal>
								<div class="feat-mark">
									{p.data.logo ? (
										<img src={p.data.logo} alt="" width="56" height="56" />
									) : (
										<span class="mono">{projMark[p.id] ?? p.data.title.slice(0, 2)}</span>
									)}
								</div>
								<div class="feat-body">
									<div class="feat-top">
										<h3>{pick(p.data.title, p.data.titleEn)}</h3>
										<span class="badge">
											{pick(p.data.badge ?? '', p.data.badgeEn) || (en ? 'Production' : '실서비스')}
										</span>
									</div>
									<span class="feat-period">{p.data.period}</span>
									<span class="feat-desc">{pick(p.data.description, p.data.descriptionEn)}</span>
									<span class="more">{t('viewDetail')}</span>
								</div>
							</a>
						))
					}
				</div>
			</section>

			<!-- 최근 글: 날짜 | 제목 | 대표 태그 -->
			<section class="wrap block">
				<div class="sec-head">
					<h2>{t('writing')}</h2>
					<a href={localize('/blog', lang)}>{t('viewAll')}</a>
				</div>
				<ul class="post-rows">
					{
						posts.map((post) => (
							<li data-reveal>
								<a href={localize(`/blog/${post.id}/`, lang)}>
									<FormattedDate date={post.data.pubDate} />
									<span class="post-title">{pick(post.data.title, post.data.titleEn)}</span>
									{post.data.tags[0] && <span class="post-tag">{post.data.tags[0]}</span>}
								</a>
							</li>
						))
					}
				</ul>
			</section>

			<!-- 기술 스택: 그룹별 열 -->
			<section class="wrap block">
				<div class="sec-head"><h2>Tech Stack</h2></div>
				<div class="stack">
					{
						stack.map((s) => (
							<div class="stack-group">
								<h3>{s.group}</h3>
								<ul class="tags">
									{s.items.map((it) => (
										<li class="tag">{it}</li>
									))}
								</ul>
							</div>
						))
					}
				</div>
			</section>

			<!-- 수상 | 자격증: 2열 압축 -->
			<section class="wrap block creds">
				<div>
					<div class="sec-head"><h2>{en ? 'Awards' : '수상'}</h2></div>
					<ul class="cred-list">
						{
							awards.map((a) => (
								<li>
									<span class="cred-name">
										{L(a.title)}
										<span class="cred-sub">{L(a.result)}</span>
									</span>
									<span class="cred-date">{L(a.meta)}</span>
								</li>
							))
						}
					</ul>
				</div>
				<div>
					<div class="sec-head"><h2>{en ? 'Certificates' : '자격증'}</h2></div>
					<ul class="cred-list">
						{
							certs.map(([name, date]) => (
								<li>
									<span class="cred-name">{name}</span>
									<span class="cred-date">{date}</span>
								</li>
							))
						}
					</ul>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	main.home {
		max-width: none;
		padding: 0;
	}
	.wrap {
		max-width: calc(var(--wrap) + var(--gutter) * 2);
		margin-inline: auto;
		padding-inline: var(--gutter);
	}
	.mono {
		font-family: var(--font-mono);
	}

	/* ---- hero: 비대칭 split ---- */
	.hero {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 248px;
		gap: 4rem;
		align-items: end;
		padding-top: 4.5rem;
		padding-bottom: 3.5rem;
	}
	.eyebrow {
		font-family: var(--font-mono);
		font-size: 0.8rem;
		color: rgb(var(--gray));
		margin: 0 0 1.1rem;
	}
	.hero h1 {
		font-size: clamp(2rem, 1.15rem + 2.6vw, 2.9rem);
		font-weight: 800;
		line-height: 1.22;
		max-width: 19em;
		margin: 0 0 1.1rem;
		text-wrap: balance;
	}
	/* 영문 헤드라인은 글자 수가 많아 한 단계 작게: 데스크톱 2줄 유지 */
	.hero h1:lang(en) {
		font-size: clamp(1.9rem, 1rem + 2.1vw, 2.35rem);
		max-width: 22em;
	}
	.sub {
		font-size: 1.08rem;
		max-width: 44ch;
		margin: 0 0 1.6rem;
	}
	.contact {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem 1.4rem;
		font-family: var(--font-mono);
		font-size: 0.85rem;
	}
	.contact a {
		display: inline-flex;
		align-items: center;
		gap: 0.45em;
		color: rgb(var(--gray-dark));
		text-decoration: none;
		border-bottom: 1px solid var(--line);
		padding-bottom: 2px;
	}
	.contact svg {
		width: 1.05em;
		height: 1.05em;
		flex: none;
	}
	.contact a:hover {
		color: var(--accent);
		border-color: var(--accent);
	}
	.portrait {
		aspect-ratio: 1;
		border: 1px solid var(--line);
		background: #fff;
		overflow: hidden;
	}
	.portrait img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 50% 20%;
	}

	/* ---- 측정값 띠: 전체 폭, 3칸, 세로 hairline ---- */
