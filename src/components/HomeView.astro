---
// 홈: 웹 이력서. 왼쪽 고정 사이드바(사진, 이름, 연락처, 목차) + 오른쪽 이력서 순서 본문.
// 숫자는 문장 속에 굵게만. 실제 수치만 쓴다(프로젝트 frontmatter 와 같은 값).
import { getCollection } from 'astro:content';
import BaseHead from './BaseHead.astro';
import Footer from './Footer.astro';
import Header from './Header.astro';
import ProjectEntry from './ProjectEntry.astro';
import { PROFILE, SITE_DESCRIPTION, tabTitle } from '../consts';
import { type Lang, localize, useTranslations } from '../i18n';

interface Props {
	lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const en = lang === 'en';
const pick = (ko: string, e?: string) => (en && e ? e : ko);
const L = (o: { ko: string; en: string }) => (en ? o.en : o.ko);
const LA = (o: { ko: string[]; en: string[] }) => (en ? o.en : o.ko);

const side = {
	title: { ko: '백엔드 / 인프라 개발자', en: 'Backend / Infrastructure Engineer' },
	org: { ko: '부산대 AI융합교육원 연구원', en: 'Researcher, PNU AI Convergence Education Institute' },
	intro: {
		ko: '증상이 아니라 근본 원인을, 감이 아니라 실측으로.',
		en: 'Root cause over symptom, measurement over guesswork.',
	},
};

// 아이콘: Tabler Icons (MIT) 경로
const icons = {
	mail: '<path d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10z"/><path d="M3 7l9 6l9 -6"/>',
	github:
		'<path d="M9 19c-4.3 1.4 -4.3 -2.5 -6 -3m12 5v-3.5c0 -1 .1 -1.4 -.5 -2c2.8 -.3 5.5 -1.4 5.5 -6a4.6 4.6 0 0 0 -1.3 -3.2a4.2 4.2 0 0 0 -.1 -3.2s-1.1 -.3 -3.5 1.3a12.3 12.3 0 0 0 -6.2 0c-2.4 -1.6 -3.5 -1.3 -3.5 -1.3a4.2 4.2 0 0 0 -.1 3.2a4.6 4.6 0 0 0 -1.3 3.2c0 4.6 2.7 5.7 5.5 6c-.6 .6 -.6 1.2 -.5 2v3.5"/>',
	instagram:
		'<path d="M4 8a4 4 0 0 1 4 -4h8a4 4 0 0 1 4 4v8a4 4 0 0 1 -4 4h-8a4 4 0 0 1 -4 -4z"/><path d="M9 12a3 3 0 1 0 6 0a3 3 0 0 0 -6 0"/><path d="M16.5 7.5v.01"/>',
	notes:
		'<path d="M5 5a2 2 0 0 1 2 -2h10a2 2 0 0 1 2 2v14a2 2 0 0 1 -2 2h-10a2 2 0 0 1 -2 -2z"/><path d="M9 7l6 0"/><path d="M9 11l6 0"/><path d="M9 15l4 0"/>',
};
const contacts = [
	{ icon: icons.mail, href: `mailto:${PROFILE.email}`, label: PROFILE.email },
	{ icon: icons.github, href: PROFILE.github, label: `github.com/${PROFILE.githubHandle}`, ext: true },
	{ icon: icons.instagram, href: PROFILE.instagram, label: `instagram.com/${PROFILE.instagramHandle}`, ext: true },
	{ icon: icons.notes, href: localize('/blog', lang), label: en ? 'Blog' : '블로그' },
];

const sections = [
	{ id: 'experience', label: { ko: '경력', en: 'Experience' } },
	{ id: 'projects', label: { ko: '프로젝트', en: 'Projects' } },
	{ id: 'skills', label: { ko: '기술', en: 'Skills' } },
	{ id: 'awards', label: { ko: '수상', en: 'Awards' } },
	{ id: 'writing', label: { ko: '글', en: 'Writing' } },
];
const secLabel = (id: string) => L(sections.find((s) => s.id === id)!.label);

const summary = {
	ko: '부산대 교내 실서비스 5개(Code Place, AIPMS, PNUAICMS, AI역량지원시스템, Pickle)를 개발하거나 운영합니다. Code Place는 누적 가입 학생 <strong>932명</strong>, 누적 제출 <strong>51,070건</strong>이고, 직접 만든 로컬 LLM AI 조교는 동접 30명에서 평균 <strong>2.89초</strong>로 응답합니다(외부 AI API 비용 0원). 멀티 노드 K3s 클러스터를 운영하며 겪은 장애는 근본 원인까지 따라가 글로 남깁니다.',
	en: 'I develop or operate five live services at Pusan National University (Code Place, AIPMS, PNUAICMS, AI Competency Support System, Pickle). Code Place has <strong>932</strong> registered students and <strong>51,070</strong> submissions, and the local-LLM AI tutor I built answers in <strong>2.89 s</strong> on average with 30 concurrent users, at zero external AI API cost. I run a multi-node K3s cluster and write up production incidents down to their root cause.',
};

// 불릿의 <strong> 은 여기서 직접 쓴 문자열에만 있다(set:html).
const experience = [
	{
		org: { ko: '부산대학교 AI융합교육원', en: 'PNU AI Convergence Education Institute' },
		period: { ko: '2026.02 - 현재', en: '2026.02 - present' },
		role: {
			ko: '연구원 (2026.08 - 현재) | SW조교 (2026.02 - 2026.07)',
			en: 'Researcher (2026.08 - present) | SW Assistant (2026.02 - 2026.07)',
		},
		points: {
			ko: [
				'Code Place: 3인 개발팀을 리딩하며 멀티 노드 K3s 인프라와 백엔드를 맡고, 로컬 LLM 기반 AI 조교를 기획, 개발했습니다.',
				'AIPMS: 팀원과 둘이 개발해 8월에 열었고, 9월부터 혼자 운영합니다(가입자 <strong>498명</strong>).',
				'PNUAICMS: AI기업 산학협력 관리 시스템을 단독 개발해 운영합니다(관리 기업 <strong>208개</strong>, 학생 <strong>1,002명</strong>).',
				'AI역량지원시스템: Spring Boot 부트캠프 서비스와 화면에서 수강 신청, 이수 심사 기능 개발에 참여하고 운영 장애를 복구했습니다(부트캠프 수강 신청 <strong>212건</strong>).',
				'Pickle: 교내 클라우드와 LLM 서비스의 기관 관리자로 승인 기준, 용량 산정, 장애 대응을 맡습니다.',
			],
			en: [
				'Code Place: lead a 3-person team, own the backend and the multi-node K3s infrastructure, and designed and built a local-LLM AI teaching assistant.',
				'AIPMS: co-built with a teammate and launched in August; I have run it alone since September (<strong>498</strong> registered users).',
				'PNUAICMS: built and operate the AI-industry partnership management system on my own (<strong>208</strong> partner companies, <strong>1,002</strong> students).',
				'AI Competency Support System: contributed bootcamp enrollment and completion-review features to the Spring Boot service and front end, and recovered a production incident (<strong>212</strong> bootcamp enrollments).',
				'Pickle: organization admin for the campus cloud and LLM service, covering approval policy, capacity planning, and incident response.',
			],
		},
	},
	{
		org: { ko: 'PNU Mini Bootcamp (멋쟁이사자처럼)', en: 'PNU Mini Bootcamp (LikeLion)' },
		period: { ko: '2024 - 2025', en: '2024 - 2025' },
		role: { ko: '수료 (BE / FE)', en: 'Completed (BE / FE)' },
		points: {
			ko: [
				'FastAPI, Redis, Spring Boot, Docker 기반 백엔드/인프라를 실습하며 총 230시간을 이수했습니다.',
				'2025 백엔드 과정에서 중고거래 API를 단독 구현하고, Redis 캐싱으로 목록 로딩을 5-10초에서 1초 이내로 줄였습니다.',
			],
			en: [
				'Practiced backend and infra with FastAPI, Redis, Spring Boot, and Docker across 230 hours.',
				'In the 2025 backend track, built a second-hand marketplace API solo and cut list loading from 5-10 s to under 1 s with Redis caching.',
			],
		},
	},
	{
		org: { ko: '부산대 인공지능 동아리 AID', en: 'AID, PNU AI Club' },
		period: { ko: '2024.09 - 2024.11', en: '2024.09 - 2024.11' },
		role: { ko: '머신러닝/딥러닝 스터디 (4인)', en: 'ML/DL study group (4 members)' },
		points: {
			ko: [
				'"혼자 공부하는 머신러닝+딥러닝"으로 회귀, 분류, 트리, 비지도 학습부터 이미지/텍스트 신경망까지 매주 대면 발표로 공부했습니다.',
				'9개 장 전부를 블로그에 정리했습니다.',
			],
			en: [
				'Worked through "Machine Learning + Deep Learning on Your Own" with weekly in-person presentations, from regression, classification, trees, and unsupervised learning to image and text neural networks.',
				'Wrote up all nine chapters on my blog.',
			],
		},
		link: 'https://github.com/Parkhaeil/ML-DL-study',
	},
];

const education = [
	{
		school: { ko: '부산대학교 정보컴퓨터공학부', en: 'Pusan National University, Computer Science' },
		period: { ko: '2023.03 - 2026.02', en: '2023.03 - 2026.02' },
		role: { ko: '졸업', en: 'B.S.' },
	},
];

const projects = (await getCollection('projects', (p) => !p.data.draft))
	.filter((p) => p.data.featured)
	.sort((a, b) => a.data.order - b.data.order);

// 그룹도, 그룹 안 항목도 많이 쓰는 순서. 앞의 core 개수만큼은 주력(굵게).
const stack = [
	{ group: 'Back-end', core: 2, items: ['Python', 'Django / DRF', 'FastAPI', 'Java', 'Spring Boot', 'Node.js'] },
	{ group: 'Infrastructure', core: 1, items: ['Kubernetes (K3s)', 'Docker', 'Longhorn', 'Harbor', 'GitHub Actions'] },
	{ group: 'Database & Cache', core: 1, items: ['PostgreSQL', 'Redis', 'MySQL', 'SQLite'] },
	{ group: 'AI / LLM', core: 1, items: ['vLLM', 'Ollama', 'Qwen', 'Locust'] },
	{ group: 'Front-end', core: 0, items: ['TypeScript', 'React', 'JavaScript', 'Vue', 'Flutter', 'Dart'] },
];

const awards = [
	{
		date: '2025.08',
		title: { ko: '제6회 PNU 창의융합SW해커톤', en: '6th PNU SW Hackathon' },
		result: { ko: '장려상 / 소프트웨어융합교육원장상', en: 'Encouragement Award' },
	},
	{
		date: '2024.12',
		title: { ko: 'PNU 정보컴퓨터공학부 아이디어톤', en: 'PNU CSE Ideathon' },
		result: { ko: '3등 / 학과장상', en: '3rd Place' },
	},
	{
		date: '2024.11',
		title: { ko: '제3회 PNU 메디컬 해커톤', en: '3rd PNU Medical Hackathon' },
		result: { ko: '우수상 / 산학협력본부장상', en: 'Excellence Award' },
	},
];

// 날짜 칸이 있으니 최근 순
const certs = [
	// 직무 관련 중요도 순(날짜순 아님)
	['2025.09', '정보처리기사', 'Engineer Information Processing'],
	['2024.06', 'SQLD', 'SQLD'],
	['2022.10', '네트워크관리사 2급', 'Network Administrator Lv.2'],
	['2025.02', 'OPIc IM2', 'OPIc IM2'],
	['2022.06', '컴퓨터활용능력 2급', 'Computer Specialist Lv.2'],
	['2025.10', '한국사능력검정 3급', 'Korean History Lv.3'],
];

const posts = (await getCollection('blog', (p) => !p.data.draft))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 5);
const ymd = (d: Date) => d.toISOString().slice(0, 10).replaceAll('-', '.');
---

<!doctype html>
<html lang={lang}>
	<head>
		<BaseHead title={tabTitle('홈')} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="resume" data-enter>
			<aside class="side">
				<img class="photo" src="/images/profile.png" alt={en ? PROFILE.nameEn : PROFILE.name} width="112" height="112" />
				<h1 class="name">{en ? PROFILE.nameEn : PROFILE.name}</h1>
				<p class="name-alt">{en ? PROFILE.name : PROFILE.nameEn}</p>
				<p class="title">{L(side.title)}</p>
				<p class="org">{L(side.org)}</p>
				<p class="intro">{L(side.intro)}</p>
				<ul class="contact">
					{
						contacts.map((c) => (
							<li>
								<a href={c.href} {...(c.ext ? { target: '_blank', rel: 'noopener' } : {})}>
									<svg
										viewBox="0 0 24 24"
										width="16"
										height="16"
										fill="none"
										stroke="currentColor"
										stroke-width="1.75"
										stroke-linecap="round"
										stroke-linejoin="round"
										aria-hidden="true"
										set:html={c.icon}
									/>
									<span>{c.label}</span>
								</a>
							</li>
						))
					}
				</ul>
				<nav class="toc" aria-label={en ? 'Sections' : '목차'}>
					<ul>
						{
							sections.map((s) => (
								<li>
									<a href={`#${s.id}`}>{L(s.label)}</a>
								</li>
							))
						}
					</ul>
				</nav>
			</aside>

			<div class="body">
				<section aria-labelledby="h-summary">
					<h2 id="h-summary" class="sec-title">{en ? 'Summary' : '요약'}</h2>
					<p class="summary" set:html={L(summary)} />
				</section>

				<section id="experience" aria-labelledby="h-experience">
					<h2 id="h-experience" class="sec-title">{secLabel('experience')}</h2>
					<ol class="rows">
						{
							experience.map((e) => (
								<li>
									<span class="when">{L(e.period)}</span>
									<div>
										<h3>{L(e.org)}</h3>
										<p class="role">{L(e.role)}</p>
										<ul class="pts">
											{LA(e.points).map((x) => (
												<li set:html={x} />
											))}
										</ul>
										{e.link && (
											<a class="ext" href={e.link} target="_blank" rel="noopener">
												GitHub ↗
											</a>
										)}
									</div>
								</li>
							))
						}
					</ol>
					<h3 class="sub-title">{en ? 'Education' : '학력'}</h3>
					<ol class="rows">
						{
							education.map((e) => (
								<li>
									<span class="when">{L(e.period)}</span>
									<div>
										<h3>{L(e.school)}</h3>
										<p class="role">{L(e.role)}</p>
									</div>
								</li>
							))
						}
					</ol>
				</section>

				<section id="projects" aria-labelledby="h-projects">
					<h2 id="h-projects" class="sec-title">{secLabel('projects')}</h2>
					{projects.map((p) => <ProjectEntry p={p} lang={lang} />)}
					<a class="more" href={localize('/projects', lang)}>{en ? 'More projects →' : '다른 프로젝트 보기 →'}</a>
				</section>

				<section id="skills" aria-labelledby="h-skills">
					<h2 id="h-skills" class="sec-title">{secLabel('skills')}</h2>
					<dl class="rows tight">
						{
							stack.map((s) => (
								<div>
									<dt class="when">{s.group}</dt>
									<dd>
										{s.items.map((it, i) => (
											<>
												{i > 0 && ', '}
												{i < s.core ? <strong>{it}</strong> : it}
											</>
										))}
									</dd>
								</div>
							))
						}
					</dl>
				</section>

				<section id="awards" aria-labelledby="h-awards">
					<h2 id="h-awards" class="sec-title">{secLabel('awards')}</h2>
					<ol class="rows tight">
						{
							awards.map((a) => (
								<li>
									<span class="when">{a.date}</span>
									<div>
										<span class="item">{L(a.title)}</span>
										<span class="item-sub">{L(a.result)}</span>
									</div>
								</li>
							))
						}
					</ol>
					<h3 class="sub-title">{en ? 'Certificates' : '자격증'}</h3>
					<ol class="rows tight">
						{
							certs.map(([date, ko, e]) => (
								<li>
									<span class="when">{date}</span>
									<span class="item">{en ? e : ko}</span>
								</li>
							))
						}
					</ol>
				</section>

				<section id="writing" aria-labelledby="h-writing">
					<h2 id="h-writing" class="sec-title">{secLabel('writing')}</h2>
					<ol class="rows tight">
						{
							posts.map((post) => (
								<li>
									<time class="when" datetime={post.data.pubDate.toISOString()}>
										{ymd(post.data.pubDate)}
									</time>
									<a class="post" href={localize(`/blog/${post.id}/`, lang)}>
										{pick(post.data.title, post.data.titleEn)}
									</a>
								</li>
							))
						}
					</ol>
					<a class="more" href={localize('/blog', lang)}>{t('viewAll')}</a>
				</section>
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	.resume {
		display: grid;
		grid-template-columns: 17.5rem minmax(0, 1fr);
		column-gap: 4rem;
		align-items: start;
	}

	/* ---- 왼쪽 사이드바 ---- */
	.side {
		font-size: 0.92rem;
		line-height: 1.55;
	}
	/* 화면이 사이드바보다 낮으면 고정하지 않는다(아래가 잘리지 않게) */
	@media (min-width: 900px) and (min-height: 780px) {
		.side {
			position: sticky;
			top: calc(var(--header-h) + 2.5rem);
		}
	}
	.photo {
		display: block;
		width: 112px;
		height: 112px;
		object-fit: cover;
		object-position: 50% 18%;
		border: 1px solid var(--line);
		margin-bottom: 1.25rem;
	}
	.name {
		font-size: 1.75rem;
		font-weight: 700;
		line-height: 1.2;
		margin: 0;
	}
	.name-alt {
		margin: 0.2rem 0 0;
		color: rgb(var(--gray));
	}
	.title {
		margin: 1rem 0 0;
		font-size: 1rem;
		font-weight: 600;
		color: rgb(var(--black));
	}
	.org {
		margin: 0.1rem 0 0;
	}
	.intro {
		margin: 0.85rem 0 0;
		color: rgb(var(--gray));
	}
	.contact {
		list-style: none;
		margin: 1.4rem 0 0;
		padding: 0;
	}
	.contact li + li {
		margin-top: 0.35rem;
	}
	.contact a {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		color: rgb(var(--gray-dark));
		text-decoration: none;
		overflow-wrap: anywhere;
	}
	.contact a:hover {
		color: var(--accent);
	}
	.contact svg {
		flex: none;
		color: rgb(var(--gray));
	}
	.contact a:hover svg {
		color: inherit;
	}
	.toc {
		margin-top: 1.5rem;
		padding-top: 1.1rem;
		border-top: 1px solid var(--line-soft);
	}
	.toc ul {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.toc a {
		display: block;
		padding: 0.15rem 0;
		color: rgb(var(--gray-dark));
		text-decoration: none;
	}
	.toc a:hover {
		color: var(--accent);
	}

	/* ---- 오른쪽 본문 ---- */
	.body {
		max-width: 46rem;
	}
	.body > section + section {
		margin-top: 3.5rem;
	}
	.body > section {
		scroll-margin-top: calc(var(--header-h) + 1.5rem);
	}
	.summary {
		margin: 0;
		font-size: 1.02rem;
		line-height: 1.85;
	}
	.summary :global(strong),
	.pts :global(strong) {
		color: rgb(var(--black));
	}

	/* 이력서 행: 왼쪽 기간 | 오른쪽 내용. 카드 박스 없이 간격으로만 나눈다 */
