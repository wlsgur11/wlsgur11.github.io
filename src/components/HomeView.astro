---
import { getCollection } from 'astro:content';
import BaseHead from './BaseHead.astro';
import Footer from './Footer.astro';
import FormattedDate from './FormattedDate.astro';
import Header from './Header.astro';
import ProjectCard from './ProjectCard.astro';
import { PROFILE, SITE_DESCRIPTION, tabTitle } from '../consts';
import { type Lang, localize, useTranslations } from '../i18n';

interface Props {
	lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const en = lang === 'en';
const pick = (ko: string, e?: string) => (en && e ? e : ko);
const L = (o: { ko: string; en: string }) => (en ? o.en : o.ko);

// 히어로: 텍스트 요소 4개 (이름+소속, 헤드라인, 서브, 버튼 줄)
const hero = {
	eyebrow: {
		ko: '부산대 AI융합교육원 연구원',
		en: 'Researcher, PNU AI Convergence Education Institute',
	},
	// 데스크톱에서 줄을 여기서 나눈다. 모바일은 이어 붙여 자연스럽게 감싼다.
	headline: {
		ko: ['실서비스를 직접 운영하는', '백엔드 / 인프라 개발자'],
		en: ['Backend and infrastructure', 'engineer who runs real services'],
	},
	// 주황으로 칠할 줄 (차별점이 있는 줄)
	accent: { ko: 0, en: 1 },
	sub: {
		ko: 'Code Place, AICMS, AIPMS, Pickle. 부산대 교내 서비스 4개의 개발과 운영을 맡고 있습니다.',
		en: 'Code Place, AICMS, AIPMS, Pickle. I develop and operate four live services at Pusan National University.',
	},
};
const emailLabel = en ? 'Email me' : '이메일 보내기';

// 핵심 숫자 띠 (PPT 카드 문법: 숫자 + 단위 + 라벨 + 보조 한 줄). 실제 수치만.
// 영문은 단위가 명사일 때 비우고 라벨이 명사를 맡는다.
const stats = [
	{
		value: '932',
		unit: { ko: '명', en: '' },
		label: { ko: 'Code Place 누적 가입 학생', en: 'Students signed up on Code Place' },
		sub: { ko: '2024년 266명에서 3.5배', en: 'Up 3.5x from 266 in 2024' },
		href: '/projects/code-place/',
	},
	{
		value: '51,070',
		unit: { ko: '건', en: '' },
		label: { ko: 'Code Place 누적 제출', en: 'Submissions on Code Place' },
		sub: { ko: '대회 14회 개최', en: '14 contests hosted' },
		href: '/projects/code-place/',
	},
	{
		value: '2.89',
		unit: { ko: '초', en: 's' },
		label: { ko: '동접 30명 AI 조교 평균 응답', en: 'Avg AI-tutor reply, 30 concurrent users' },
		sub: { ko: '외부 AI API 비용 0원', en: 'Zero spend on external AI APIs' },
		href: '/blog/code-place-ai-tutor-load-test/',
	},
	{
		value: '1,002',
		unit: { ko: '명', en: '' },
		label: { ko: 'AICMS 관리 학생', en: 'Students managed in AICMS' },
		sub: { ko: '관리 기업 208개', en: '208 partner companies' },
		href: '/projects/pnuaicms/',
	},
];

const allPosts = (await getCollection('blog', (p) => !p.data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const [leadPost, ...restPosts] = allPosts.slice(0, 4);

const projects = (await getCollection('projects', (p) => !p.data.draft))
	.filter((p) => p.data.featured)
	.sort((a, b) => a.data.order - b.data.order);

const experience = [
	{
		mark: 'AI',
		logo: '/images/logos/pnu.png',
		org: { ko: '부산대학교 AI융합교육원', en: 'PNU AI Convergence Education Institute' },
		badge: { ko: '운영', en: 'Ops' },
		period: { ko: '2026.02 - 현재', en: '2026.02 - present' },
		role: {
			ko: '연구원 (2026.08 - 현재) | SW조교 (2026.02 - 2026.07)',
			en: 'Researcher (2026.08 - present) | SW Assistant (2026.02 - 2026.07)',
		},
		desc: {
			ko: '교육원 개발 업무를 담당. 실서비스 온라인 저지 "Code Place"의 기능 개발과 인프라 운영을 맡아 3인 개발팀을 리딩하고, 멀티 노드 K3s 환경의 운영 문제를 해결하며 로컬 LLM 기반 AI 조교를 기획, 개발했습니다.',
			en: 'Responsible for the institute’s software development. Own feature development and infrastructure for "Code Place", a production Online Judge. Lead a 3-person team, resolve operational issues on a multi-node K3s cluster, and built a local-LLM AI teaching assistant.',
		},
	},
	{
		mark: 'LL',
		logo: '/images/logos/pnu.png',
		org: { ko: 'PNU Mini Bootcamp (멋쟁이사자처럼)', en: 'PNU Mini Bootcamp (LikeLion)' },
		badge: { ko: '부트캠프', en: 'Bootcamp' },
		period: { ko: '2024 - 2025', en: '2024 - 2025' },
		role: { ko: '수료 (BE / FE)', en: 'Completed (BE / FE)' },
		desc: {
			ko: 'FastAPI, Redis, Spring Boot, Docker 기반 백엔드/인프라를 실습하며 총 230시간을 이수했습니다.',
			en: 'Practiced backend and infra with FastAPI, Redis, Spring Boot, and Docker across 230 hours.',
		},
	},
	{
		mark: 'AID',
		logo: '',
		org: { ko: '부산대 인공지능 동아리 AID', en: 'AID, PNU AI Club' },
		badge: { ko: '스터디', en: 'Study' },
		period: { ko: '2024.09 - 2024.11', en: '2024.09 - 2024.11' },
		role: { ko: '머신러닝/딥러닝 스터디 (4인)', en: 'ML/DL study group (4 members)' },
		desc: {
			ko: '"혼자 공부하는 머신러닝+딥러닝"으로 회귀, 분류, 트리, 비지도 학습부터 이미지/텍스트 신경망까지 매주 대면 발표로 공부하고, 9개 장 전부를 블로그에 정리했습니다.',
			en: 'Worked through "Machine Learning + Deep Learning on Your Own" with weekly in-person presentations, from regression, classification, trees, and unsupervised learning to image and text neural networks, and wrote up all nine chapters on my blog.',
		},
		link: 'https://github.com/Parkhaeil/ML-DL-study',
	},
];

const education = [
	{
		logo: '/images/logos/pnu.png',
		school: { ko: '부산대학교 정보컴퓨터공학부', en: 'Pusan National University, Computer Science' },
		period: { ko: '2023.03 - 2026.02', en: '2023.03 - 2026.02' },
		role: { ko: '졸업', en: 'B.S.' },
	},
];

// 그룹도, 그룹 안 항목도 많이 쓰는 순서. 앞의 core 개수만큼은 주력으로 칠한다.
const stack = [
	{ group: 'Back-end', core: 2, items: ['Python', 'Django / DRF', 'FastAPI', 'Java', 'Spring Boot', 'Node.js'] },
	{ group: 'Infrastructure', core: 1, items: ['Kubernetes (K3s)', 'Docker', 'Longhorn', 'Harbor', 'GitHub Actions'] },
	{ group: 'Database & Cache', core: 1, items: ['PostgreSQL', 'Redis', 'MySQL', 'SQLite'] },
	{ group: 'AI / LLM', core: 1, items: ['vLLM', 'Ollama', 'Qwen', 'Locust'] },
	{ group: 'Front-end', core: 0, items: ['TypeScript', 'React', 'JavaScript', 'Vue', 'Flutter', 'Dart'] },
];

const awards = [
	{
		title: { ko: '제6회 PNU 창의융합SW해커톤', en: '6th PNU SW Hackathon' },
		meta: { ko: '2025.08 | 팀', en: '2025.08 | Team' },
		result: { ko: '장려상 / 소프트웨어융합교육원장상', en: 'Encouragement Award' },
	},
	{
		title: { ko: 'PNU 정보컴퓨터공학부 아이디어톤', en: 'PNU CSE Ideathon' },
		meta: { ko: '2024.12 | 팀', en: '2024.12 | Team' },
		result: { ko: '3등 / 학과장상', en: '3rd Place' },
	},
	{
		title: { ko: '제3회 PNU 메디컬 해커톤', en: '3rd PNU Medical Hackathon' },
		meta: { ko: '2024.11 | 팀', en: '2024.11 | Team' },
		result: { ko: '우수상 / 산학협력본부장상', en: 'Excellence Award' },
	},
];

const certs = en
	? [
			['Engineer Information Processing', '2025.09'],
			['SQLD', '2024.06'],
			['Network Administrator Lv.2', '2022.10'],
			['Computer Specialist Lv.2', '2022.06'],
			['OPIc IM2', '2025.02'],
			['Korean History Lv.3', '2025.10'],
		]
	: [
			['정보처리기사', '2025.09'],
			['SQLD', '2024.06'],
			['네트워크관리사 2급', '2022.10'],
			['컴퓨터활용능력 2급', '2022.06'],
			['OPIc IM2', '2025.02'],
			['한국사능력검정 3급', '2025.10'],
		];

// 섹션 제목 + 한 줄 부제 (PPT 문법)
const sec = {
	projects: {
		title: { ko: '운영 중인 서비스', en: 'Live services' },
		sub: {
			ko: '부산대에서 지금 쓰이는 서비스입니다.',
			en: 'In production at PNU right now.',
		},
	},
	career: {
		title: { ko: '경력과 학력', en: 'Experience and education' },
		sub: {
			ko: '2026년부터 AI융합교육원에서 일합니다.',
			en: 'At the PNU AI institute since 2026.',
		},
	},
	stack: {
		title: { ko: '기술 스택', en: 'Tech stack' },
		sub: { ko: '많이 쓰는 순서대로, 주력은 칠해 두었습니다.', en: 'Most-used first. Core tools are filled.' },
	},
	creds: {
		title: { ko: '수상과 자격증', en: 'Awards and certificates' },
		sub: {
			ko: `교내 대회 수상 ${awards.length}회, 자격증 ${certs.length}개`,
			en: `${awards.length} campus awards, ${certs.length} certificates`,
		},
	},
	posts: {
		title: { ko: '최근 글', en: 'Recent writing' },
		sub: {
			ko: '운영하며 겪은 문제와 해결 과정을 기록합니다.',
			en: 'Production problems and how I fixed them.',
		},
	},
};

const icon = {
	github:
		'M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z',
};
---

<!doctype html>
<html lang={lang}>
	<head>
		<BaseHead title={tabTitle('홈')} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="home">
			<!-- 잉크 블록: 히어로 + 핵심 숫자 띠. 테마와 상관없이 짙은 남색 (페이지에 한 번) -->
			<div class="ink">
				<section class="hero wrap" aria-labelledby="hero-title">
					<div class="hero-text">
						<p class="hero-id" data-hero>
							<span class="hero-name">{en ? PROFILE.nameEn : PROFILE.name}</span>
							<span class="hero-role">{L(hero.eyebrow)}</span>
						</p>
						<h1 id="hero-title" data-hero>
							{hero.headline[lang].map((line, i) => <span class:list={['hl', { em: i === hero.accent[lang] }]}>{line}{i === 0 ? ' ' : ''}</span>)}
						</h1>
						<p class="hero-sub" data-hero>{L(hero.sub)}</p>
						<div class="hero-actions" data-hero>
							<a class="btn btn-solid" href="#projects">{en ? 'See projects' : '프로젝트 보기'}</a>
							<a class="btn btn-line" href={PROFILE.github} target="_blank" rel="noopener">
								<svg viewBox="0 0 16 16" width="16" height="16" fill="currentColor" aria-hidden="true"
									><path d={icon.github} /></svg
								>GitHub
							</a>
							<span class="hero-links">
								<a href={`mailto:${PROFILE.email}`}>
									<svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><rect x="1.5" y="3" width="13" height="10" rx="1.5" /><path d="M2 4l6 4.5L14 4" /></svg>{emailLabel}</a
								>
								<a href={PROFILE.instagram} target="_blank" rel="noopener">
									<svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><rect x="1.5" y="1.5" width="13" height="13" rx="4" /><circle cx="8" cy="8" r="3.2" /><circle cx="12" cy="4" r="0.55" fill="currentColor" stroke="none" /></svg>Instagram</a
								>
							</span>
						</div>
					</div>
					<div class="portrait">
						<img src="/images/profile.png" alt={en ? PROFILE.nameEn : PROFILE.name} width="896" height="1060" />
					</div>
				</section>

				<div class="stats-band" data-band>
					<ul class="wrap stats" aria-label={en ? 'Key numbers' : '핵심 숫자'}>
						{
							stats.map((s) => (
								<li>
									<a class="stat" href={localize(s.href, lang)}>
										<span class="stat-fig">
											<span class="stat-num" data-count={s.value}>
												{s.value}
											</span>
											{L(s.unit) && <span class="stat-unit">{L(s.unit)}</span>}
										</span>
										<span class="stat-label">{L(s.label)}</span>
										<span class="stat-sub">{L(s.sub)}</span>
									</a>
								</li>
							))
						}
					</ul>
				</div>
			</div>

			<!-- 운영 중인 서비스: 화면 캡처 카드 2x2 -->
			<section id="projects" class="wrap block">
				<header class="sec-head">
					<div>
						<h2>{L(sec.projects.title)}</h2>
						<p class="sec-sub">{L(sec.projects.sub)}</p>
					</div>
					<a class="sec-more" href={localize('/projects', lang)}>{t('viewAll')}</a>
				</header>
				<div class="services">
					{projects.map((p) => <ProjectCard p={p} lang={lang} />)}
				</div>
			</section>

			<!-- 경력과 학력: 경력은 기간 | 내용 행, 학력은 옆 칸 -->
			<section class="wrap block">
				<header class="sec-head">
					<div>
						<h2>{L(sec.career.title)}</h2>
						<p class="sec-sub">{L(sec.career.sub)}</p>
					</div>
				</header>
				<div class="career">
					<ol class="timeline">
						{
							experience.map((e) => (
								<li class="tl-row" data-reveal>
									<span class="tl-when">{L(e.period)}</span>
									<div class="tl-what">
										<div class="tl-head">
											{e.logo ? (
												<img class="tl-logo" src={e.logo} alt="" width="28" height="28" />
											) : (
												<span class="tl-logo mono">{e.mark}</span>
											)}
											<h3>{L(e.org)}</h3>
											<span class="badge">{L(e.badge)}</span>
										</div>
										<p class="tl-role">{L(e.role)}</p>
										<p class="tl-desc">{L(e.desc)}</p>
										{e.link && (
											<a class="tl-link" href={e.link} target="_blank" rel="noopener">
												GitHub ↗
											</a>
										)}
									</div>
								</li>
							))
						}
					</ol>
					<aside class="edu" data-reveal>
						<h3 class="edu-title">{en ? 'Education' : '학력'}</h3>
						{
							education.map((e) => (
								<div class="edu-row">
									<img class="tl-logo" src={e.logo} alt="" width="28" height="28" />
									<div>
										<p class="edu-school">{L(e.school)}</p>
										<p class="edu-meta">
											{L(e.role)} | {L(e.period)}
										</p>
									</div>
								</div>
							))
						}
					</aside>
				</div>
			</section>

			<!-- 기술 스택: 그룹별 열, 많이 쓰는 순 -->
			<section class="wrap block">
				<header class="sec-head">
					<div>
						<h2>{L(sec.stack.title)}</h2>
						<p class="sec-sub">{L(sec.stack.sub)}</p>
					</div>
				</header>
				<div class="stack">
					{
						stack.map((s) => (
							<div class="stack-group">
								<h3>{s.group}</h3>
								<ul class="tags">
									{s.items.map((it, i) => (
										<li class:list={['tag', { core: i < s.core }]}>{it}</li>
									))}
								</ul>
							</div>
						))
					}
				</div>
			</section>

			<!-- 수상 | 자격증 -->
			<section class="wrap block">
				<header class="sec-head">
					<div>
						<h2>{L(sec.creds.title)}</h2>
						<p class="sec-sub">{L(sec.creds.sub)}</p>
					</div>
				</header>
				<div class="creds">
					<ul class="awards">
						{
							awards.map((a) => (
								<li>
									<span class="aw-name">{L(a.title)}</span>
									<span class="aw-result">{L(a.result)}</span>
									<span class="aw-date">{L(a.meta)}</span>
								</li>
							))
						}
					</ul>
					<ul class="certs">
						{
							certs.map(([name, date]) => (
								<li>
									<span class="cert-name">{name}</span>
									<span class="cert-date">{date}</span>
								</li>
							))
						}
					</ul>
				</div>
			</section>

			<!-- 최근 글: 최신 1편 크게 + 3편 목록 -->
			<section class="wrap block">
				<header class="sec-head">
					<div>
						<h2>{L(sec.posts.title)}</h2>
						<p class="sec-sub">{L(sec.posts.sub)}</p>
					</div>
					<a class="sec-more" href={localize('/blog', lang)}>{t('viewAll')}</a>
				</header>
				<div class="posts">
					{
						leadPost && (
							<a class="post-lead" href={localize(`/blog/${leadPost.id}/`, lang)} data-reveal>
								<FormattedDate date={leadPost.data.pubDate} />
								<span class="post-lead-title">{pick(leadPost.data.title, leadPost.data.titleEn)}</span>
								<span class="post-lead-desc">
									{pick(leadPost.data.description, leadPost.data.descriptionEn)}
								</span>
							</a>
						)
					}
					<ul class="post-rows">
						{
							restPosts.map((post) => (
								<li data-reveal>
									<a href={localize(`/blog/${post.id}/`, lang)}>
										<FormattedDate date={post.data.pubDate} />
										<span class="post-title">{pick(post.data.title, post.data.titleEn)}</span>
									</a>
								</li>
							))
						}
					</ul>
				</div>
			</section>

			<!-- 연락: 한 줄 + 이메일 하나 -->
			<section class="contact">
				<div class="wrap contact-inner">
					<p class="contact-line">
