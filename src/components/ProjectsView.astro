---
import { getCollection } from 'astro:content';
import BaseHead from './BaseHead.astro';
import Footer from './Footer.astro';
import Header from './Header.astro';
import ProjectEntry from './ProjectEntry.astro';
import { tabTitle } from '../consts';
import { type Lang, useTranslations } from '../i18n';

interface Props {
	lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const projects = (await getCollection('projects', (p) => !p.data.draft)).sort(
	(a, b) => a.data.order - b.data.order,
);
const groups = [
	{ title: t('majorProjects'), items: projects.filter((p) => p.data.group === 'major') },
	{ title: t('moreProjects'), items: projects.filter((p) => p.data.group === 'more') },
].filter((g) => g.items.length);
---

<!doctype html>
<html lang={lang}>
	<head>
		<BaseHead title={tabTitle('프로젝트')} description={t('projectsSubtitle')} />
	</head>
	<body>
		<Header />
		<main data-enter>
			<div class="col">
				<header class="page-head">
					<h1>{t('projectsTitle')}</h1>
					<p>{t('projectsSubtitle')}</p>
				</header>
				{
					groups.map((g) => (
						<section class="group">
							<h2 class="sec-title">{g.title}</h2>
							{g.items.map((p) => (
								<ProjectEntry p={p} lang={lang} />
							))}
						</section>
					))
				}
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	.col {
		max-width: 46rem;
		margin: 0 auto;
	}
	.page-head h1 {
		margin-bottom: 0.4rem;
	}
	.page-head p {
		margin: 0;
		color: rgb(var(--gray));
	}
	.group {
		margin-top: 3rem;
	}
</style>
