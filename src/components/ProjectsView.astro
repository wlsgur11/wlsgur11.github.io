---
import { getCollection } from 'astro:content';
import BaseHead from './BaseHead.astro';
import Footer from './Footer.astro';
import Header from './Header.astro';
import { tabTitle } from '../consts';
import { type Lang, localize, useTranslations } from '../i18n';

interface Props {
	lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const pick = (ko: string, en?: string) => (lang === 'en' && en ? en : ko);

const projects = (await getCollection('projects', (p) => !p.data.draft)).sort(
	(a, b) => a.data.order - b.data.order,
);
const byGroup = (g: string) => projects.filter((p) => p.data.group === g);
const groups = [
	{ title: t('majorProjects'), variant: 'row', items: byGroup('major') },
	{ title: t('moreProjects'), variant: 'cover', items: byGroup('more') },
].filter((g) => g.items.length > 0);

const githubPath =
	'M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z';
---

<!doctype html>
<html lang={lang}>
	<head>
		<BaseHead title={tabTitle('프로젝트')} description={t('projectsSubtitle')} />
	</head>
	<body>
		<Header />
		<main>
			<header class="page-head">
				<h1>{t('projectsTitle')}</h1>
				<p class="subtitle">{t('projectsSubtitle')}</p>
			</header>

			{
				groups.map((g) => (
					<section class="group">
						<h2 class="group-title">{g.title}</h2>
						<div class="plist">
							{g.items.map((p) => {
								const href = localize(`/projects/${p.id}/`, lang);
								const bullets =
									lang === 'en' && p.data.summaryEn.length ? p.data.summaryEn : p.data.summary;
								return (
									<article class={`pcard pcard--${g.variant}`} data-reveal>
										{g.variant === 'cover' ? (
											<a class="pcard-media" href={href} aria-label={p.data.title}>
												<div class="thumb">
													{p.data.cover ? (
														<img src={p.data.cover} alt="" />
													) : (
														<div class="thumb-fallback">
															{p.data.logo ? (
																<img class="thumb-logo" src={p.data.logo} alt="" />
															) : (
																<span class="mono">{p.data.title.slice(0, 2)}</span>
															)}
														</div>
													)}
												</div>
											</a>
										) : (
											<a class="pcard-logo" href={href} aria-label={p.data.title}>
												{p.data.logo ? (
													<img src={p.data.logo} alt="" />
												) : (
													<span class="mono">{p.data.title.slice(0, 2)}</span>
												)}
											</a>
										)}
										<div class="pcard-body">
											<div class="top">
												<a class="title-link" href={href}>
													<h3>{pick(p.data.title, p.data.titleEn)}</h3>
												</a>
												{(p.data.badge || p.data.badgeEn) && (
													<span class="cat">{pick(p.data.badge ?? '', p.data.badgeEn)}</span>
												)}
											</div>
											<p class="role">{pick(p.data.role, p.data.roleEn)} | {p.data.period}</p>
											<ul class="bullets">
												{bullets.map((b) => (
													<li>{b}</li>
												))}
											</ul>
											<div class="foot">
												{p.data.links.repo && (
													<a class="ext" href={p.data.links.repo} target="_blank" rel="noopener">
														<svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true">
															<path fill="currentColor" d={githubPath} />
														</svg>
														GitHub
													</a>
												)}
												<a class="more" href={href}>{t('viewDetail')}</a>
											</div>
										</div>
									</article>
								);
							})}
						</div>
					</section>
				))
			}
		</main>
		<Footer />
	</body>
</html>

<style>
	.page-head {
		padding-top: 1.5rem;
	}
	.page-head h1 {
		font-size: 2.6rem;
		margin-bottom: 0.3rem;
	}
	.subtitle {
		color: rgb(var(--gray-dark));
		margin: 0;
		max-width: 60ch;
	}
	.group {
		margin-top: 3.5rem;
	}
	.group-title {
		font-size: 1.35rem;
		font-weight: 800;
		margin: 0 0 1.5rem;
		padding-top: 0.9rem;
		border-top: 1px solid var(--line);
	}
	.plist {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
		align-items: stretch;
	}
	/* 홀수 개면 첫 카드가 한 줄 전체: 빈 칸 없이 1 + 2 */
	.pcard:first-child:nth-last-child(odd) {
		grid-column: 1 / -1;
	}

	/* 카드 바깥(article)과 안쪽 요소 클래스는 겹치지 않게: pcard-* / thumb */
	.pcard {
		border: 1px solid var(--line);
		display: flex;
	}
	.pcard:hover {
		border-color: var(--accent);
	}

	/* row: 로고 + 본문 */
	.pcard--row {
		gap: 1.25rem;
		padding: 1.5rem;
	}
	.pcard-logo {
		flex: none;
		display: grid;
		place-items: center;
		width: 72px;
		height: 72px;
		background: var(--surface);
		border: 1px solid var(--line-soft);
		text-decoration: none;
	}
	.pcard-logo img {
		width: 48px;
		height: 48px;
		padding: 4px;
		object-fit: contain;
		background: #fff;
	}
	.mono {
		font-family: var(--font-mono);
		font-weight: 700;
		color: var(--accent);
	}

	/* cover: 표지 + 본문 */
	.pcard--cover {
		flex-direction: column;
	}
	.pcard:first-child:nth-last-child(odd).pcard--cover {
		flex-direction: row;
	}
	/* 전체 폭 표지 카드: 왼쪽 표지는 본문 높이를 따라가고 크기 계산에 끼지 않는다 */
	.pcard:first-child:nth-last-child(odd).pcard--cover .pcard-media {
		flex: 0 0 45%;
		min-width: 0;
		border-right: 1px solid var(--line);
	}
	.pcard:first-child:nth-last-child(odd).pcard--cover .thumb {
		position: relative;
		aspect-ratio: auto;
		height: 100%;
		min-height: 15rem;
		border-bottom: none;
	}
	.pcard:first-child:nth-last-child(odd).pcard--cover .thumb > img,
	.pcard:first-child:nth-last-child(odd).pcard--cover .thumb-fallback {
		position: absolute;
		inset: 0;
	}
	.pcard-media {
		display: block;
	}
	.thumb {
		aspect-ratio: 16 / 9;
		overflow: hidden;
		background: var(--surface);
		border-bottom: 1px solid var(--line);
	}
	.thumb img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		margin: 0;
	}
	.thumb-fallback {
		width: 100%;
		height: 100%;
		display: grid;
		place-items: center;
		background: var(--surface);
	}
	.thumb-fallback .thumb-logo {
		width: 88px;
		height: 88px;
		padding: 12px;
		object-fit: contain;
		background: #fff;
		border: 1px solid var(--line-soft);
	}
	.thumb-fallback .mono {
		font-size: 2rem;
	}
	.pcard--cover .pcard-body {
		padding: 1.3rem 1.4rem 1.2rem;
	}

	/* body (공용) */
	.pcard-body {
		min-width: 0;
		display: flex;
		flex-direction: column;
		flex: 1;
	}
	.top {
		display: flex;
		align-items: baseline;
		gap: 0.3rem 0.7rem;
		flex-wrap: wrap;
	}
	.title-link {
		text-decoration: none;
		color: inherit;
	}
	.title-link h3 {
		font-size: 1.2rem;
		font-weight: 800;
		margin: 0;
	}
	.pcard:hover .title-link h3 {
		color: var(--accent);
	}
	.cat {
		font-family: var(--font-mono);
		font-size: 0.74rem;
		color: rgb(var(--gray));
		white-space: nowrap;
	}
	.cat::before {
		content: '#';
	}
	.role {
		font-family: var(--font-mono);
		font-size: 0.78rem;
		color: rgb(var(--gray));
		margin: 0.4rem 0 0.8rem;
	}
	.bullets {
		margin: 0 0 1rem;
		padding-left: 1.1em;
		display: flex;
		flex-direction: column;
		gap: 0.35em;
	}
	.bullets li {
		font-size: 0.93rem;
		color: rgb(var(--gray-dark));
		line-height: 1.6;
	}
	.foot {
		display: flex;
		align-items: center;
		gap: 1.1rem;
		margin-top: auto;
	}
	.ext,
	.more {
		display: inline-flex;
		align-items: center;
		gap: 0.35em;
		font-family: var(--font-mono);
		font-size: 0.78rem;
		text-decoration: none;
	}
	.ext {
		color: rgb(var(--gray-dark));
	}
	.ext:hover {
		color: var(--accent);
	}
	.more {
		color: var(--accent);
		margin-left: auto;
	}

	@media (max-width: 767px) {
		.page-head h1 {
			font-size: 2.1rem;
		}
		.plist {
			grid-template-columns: 1fr;
		}
		.pcard--row {
			flex-direction: column;
		}
		.pcard:first-child:nth-last-child(odd).pcard--cover {
			flex-direction: column;
		}
		.pcard:first-child:nth-last-child(odd).pcard--cover .pcard-media {
			border-right: none;
		}
		.pcard:first-child:nth-last-child(odd).pcard--cover .thumb {
			aspect-ratio: 16 / 9;
			height: auto;
			min-height: 0;
			border-bottom: 1px solid var(--line);
		}
	}
</style>
