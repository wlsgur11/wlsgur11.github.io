---
import { getCollection } from 'astro:content';
import BaseHead from './BaseHead.astro';
import Footer from './Footer.astro';
import FormattedDate from './FormattedDate.astro';
import Header from './Header.astro';
import { PROJECT_LABELS, SITE_TITLE } from '../consts';
import { type Lang, localize, useTranslations } from '../i18n';

interface Props {
	lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const pick = (ko: string, en?: string) => (lang === 'en' && en ? en : ko);

const posts = (await getCollection('blog', (p) => !p.data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// 태그별 개수 (많은 순 → 이름순)
const tagCounts: Record<string, number> = {};
for (const p of posts) {
	for (const tag of p.data.tags) tagCounts[tag] = (tagCounts[tag] ?? 0) + 1;
}
const tagList = Object.entries(tagCounts).sort(
	(a, b) => b[1] - a[1] || a[0].localeCompare(b[0]),
);
const allLabel = lang === 'en' ? 'All posts' : '전체 글';
const countLabel = (n: number) =>
	lang === 'en' ? `${n} post${n === 1 ? '' : 's'}` : `${n}개의 게시글`;
---

<!doctype html>
<html lang={lang}>
	<head>
		<BaseHead title={`${t('writing')} · ${SITE_TITLE}`} description="Troubleshooting, retrospectives, learning notes." />
	</head>
	<body>
		<Header />
		<main>
			<header class="page-head">
				<h1>{t('writing')}</h1>
				<p class="post-count">{countLabel(posts.length)}</p>
				{lang === 'en' && <p class="meta">{t('koreanNotice')}</p>}
			</header>

			<div class="blog-layout">
				<aside class="tag-nav" aria-label="tags">
					<button type="button" class="tag-nav-item is-active" data-tag="">
						<span class="tn-label">{allLabel}</span>
						<span class="tn-count">{posts.length}</span>
					</button>
					<div class="tag-nav-divider"></div>
					{tagList.map(([tag, n]) => (
						<button type="button" class="tag-nav-item" data-tag={tag}>
							<span class="tn-label">{tag}</span>
							<span class="tn-count">{n}</span>
						</button>
					))}
				</aside>

				<ul class="post-list">
					{
						posts.map((post) => (
							<li data-tags={post.data.tags.join(' ')}>
								<a class="post-link" href={localize(`/blog/${post.id}/`, lang)}>
									<span class="post-title">{pick(post.data.title, post.data.titleEn)}</span>
									<FormattedDate date={post.data.pubDate} />
								</a>
								{pick(post.data.description, post.data.descriptionEn) && (
									<p class="post-desc">{pick(post.data.description, post.data.descriptionEn)}</p>
								)}
								<div class="post-foot">
									{post.data.tags.length > 0 && (
										<ul class="tags">
											{post.data.tags.map((tag) => (
												<li>
													<button type="button" class="blog-tag" data-tag={tag}>{tag}</button>
												</li>
											))}
										</ul>
									)}
									{post.data.project && PROJECT_LABELS[post.data.project] && (
										<a class="post-project" href={localize(`/projects/${post.data.project}/`, lang)}>
											{PROJECT_LABELS[post.data.project]}
										</a>
									)}
								</div>
							</li>
						))
					}
				</ul>
			</div>
		</main>
		<Footer />
	</body>
</html>

<script>
	const items = Array.from(document.querySelectorAll<HTMLElement>('.post-list > li'));
	const navItems = Array.from(document.querySelectorAll<HTMLElement>('.tag-nav-item'));
	const countEl = document.querySelector<HTMLElement>('.post-count');
	const base = countEl?.textContent ?? '';

	function applyFilter(tag: string) {
		let shown = 0;
		for (const li of items) {
			const tags = (li.dataset.tags ?? '').split(' ').filter(Boolean);
			const show = !tag || tags.includes(tag);
			li.hidden = !show;
			if (show) shown++;
		}
		document.querySelectorAll<HTMLElement>('[data-tag]').forEach((el) => {
			el.classList.toggle('is-active', (el.dataset.tag ?? '') === tag);
		});
		if (countEl) {
			countEl.textContent = tag ? `${tag} · ${shown}` : base;
		}
	}

	document.addEventListener('click', (e) => {
		const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-tag]');
		if (!btn) return;
		e.preventDefault();
		applyFilter(btn.dataset.tag ?? '');
		if (btn.classList.contains('blog-tag')) {
			document.querySelector('.tag-nav')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
		}
	});
</script>

<style>
	main {
		width: 1080px;
		max-width: calc(100% - 3em);
		padding-inline: 1.5em;
	}
	.page-head h1 {
		margin-bottom: 0.1em;
	}
	.post-count {
		color: rgb(var(--gray));
		font-size: 0.9em;
		margin: 0;
	}
	.blog-layout {
		display: grid;
		grid-template-columns: 210px 1fr;
		gap: 4em;
		margin-top: 2em;
		align-items: start;
	}

	/* ---- 좌측 태그 목차 ---- */
	.tag-nav {
		position: sticky;
		top: 1.5em;
		display: flex;
		flex-direction: column;
		gap: 0.1em;
	}
	.tag-nav-item {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 0.6em;
		width: 100%;
		padding: 0.3em 0.1em;
		background: none;
		border: none;
		cursor: pointer;
		font-family: inherit;
		font-size: 0.9em;
		color: rgb(var(--gray));
		text-align: left;
		transition: color 0.15s ease;
	}
	.tag-nav-item .tn-label {
		text-transform: uppercase;
		letter-spacing: 0.02em;
	}
	.tag-nav-item .tn-count {
		font-family: var(--font-mono);
		font-size: 0.85em;
		opacity: 0.6;
	}
	.tag-nav-item:hover {
		color: rgb(var(--black));
	}
	.tag-nav-item.is-active {
		color: var(--accent);
		font-weight: 700;
	}
	.tag-nav-item.is-active .tn-count {
		opacity: 1;
	}
	.tag-nav-divider {
		height: 1px;
		background: rgba(var(--gray), 0.18);
		margin: 0.5em 0;
	}

	/* ---- 글 목록 ---- */
	.post-list {
		list-style: none;
		padding: 0;
		margin: 0;
	}
	.post-list > li {
		padding: 1.3em 0;
		border-bottom: 1px solid rgba(var(--gray), 0.12);
	}
	.post-list > li:first-child {
		padding-top: 0;
	}
	.post-link {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 1em;
		text-decoration: none;
		color: inherit;
	}
	.post-title {
		color: rgb(var(--black));
		font-size: 1.22em;
		font-weight: 700;
		line-height: 1.35;
	}
	.post-link:hover .post-title {
		color: var(--accent);
	}
	.post-list :global(time) {
		color: rgb(var(--gray));
		font-size: 0.82em;
		white-space: nowrap;
	}
	.post-desc {
		color: rgb(var(--gray));
		font-size: 0.92em;
		line-height: 1.6;
		margin: 0.5em 0 0;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.post-foot {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5em 0.9em;
		margin-top: 0.85em;
	}
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4em;
		padding: 0;
		margin: 0;
		list-style: none;
	}
	.blog-tag {
		display: inline-block;
		font-family: var(--font-mono);
		font-size: 0.68em;
		letter-spacing: 0.02em;
		text-transform: uppercase;
		padding: 0.3em 0.7em;
		border-radius: 999px;
		border: 1px solid rgba(var(--accent-rgb), 0.22);
		background: rgba(var(--accent-rgb), 0.08);
		color: var(--accent);
		cursor: pointer;
		transition: background 0.15s ease, border-color 0.15s ease;
	}
	.blog-tag:hover,
	.blog-tag.is-active {
		background: rgba(var(--accent-rgb), 0.18);
		border-color: rgba(var(--accent-rgb), 0.45);
	}
	.post-project {
		display: inline-flex;
		align-items: center;
		gap: 0.4em;
		margin-left: auto;
		font-family: var(--font-mono);
		font-size: 0.75em;
		color: rgb(var(--gray));
		text-decoration: none;
		white-space: nowrap;
		transition: color 0.15s ease;
	}
	.post-project::before {
		content: '';
		width: 5px;
		height: 5px;
		border-radius: 50%;
		background: var(--accent);
		opacity: 0.65;
	}
	.post-project:hover {
		color: var(--accent);
	}

	/* ---- 반응형: 좁으면 목차를 위로, 가로 스크롤 ---- */
	@media (max-width: 720px) {
		.blog-layout {
			grid-template-columns: 1fr;
			gap: 1.2em;
		}
		.tag-nav {
			position: static;
			flex-direction: row;
			flex-wrap: nowrap;
			overflow-x: auto;
			gap: 0.9em;
			padding-bottom: 0.6em;
			scrollbar-width: none;
		}
		.tag-nav::-webkit-scrollbar {
			display: none;
		}
		.tag-nav-item {
			width: auto;
			white-space: nowrap;
		}
		.tag-nav-divider {
			display: none;
		}
	}

	/* 순차 등장 */
	@media (prefers-reduced-motion: no-preference) {
		.page-head,
		.blog-layout {
			animation: text-rise 0.5s cubic-bezier(0.16, 1, 0.3, 1) both;
		}
		.blog-layout {
			animation-delay: 0.08s;
		}
	}
</style>
