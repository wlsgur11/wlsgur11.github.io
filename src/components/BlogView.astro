---
import { getCollection } from 'astro:content';
import BaseHead from './BaseHead.astro';
import Footer from './Footer.astro';
import FormattedDate from './FormattedDate.astro';
import Header from './Header.astro';
import { PROJECT_LABELS, tabTitle } from '../consts';
import { type Lang, localize, useTranslations } from '../i18n';

interface Props {
	lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const pick = (ko: string, en?: string) => (lang === 'en' && en ? en : ko);

const posts = (await getCollection('blog', (p) => !p.data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// 태그별 개수 (많은 순 → 이름순)
const tagCounts: Record<string, number> = {};
for (const p of posts) {
	for (const tag of p.data.tags) tagCounts[tag] = (tagCounts[tag] ?? 0) + 1;
}
const tagList = Object.entries(tagCounts).sort(
	(a, b) => b[1] - a[1] || a[0].localeCompare(b[0]),
);
const allLabel = lang === 'en' ? 'All posts' : '전체 글';
const countLabel = (n: number) =>
	lang === 'en' ? `${n} post${n === 1 ? '' : 's'}` : `${n}개의 게시글`;
---

<!doctype html>
<html lang={lang}>
	<head>
		<BaseHead title={tabTitle('블로그')} description="Troubleshooting, retrospectives, learning notes." />
	</head>
	<body>
		<Header />
		<main data-enter>
			<header class="page-head">
				<h1>{t('writing')}</h1>
				<p class="post-count" data-base={countLabel(posts.length)}>{countLabel(posts.length)}</p>
				{lang === 'en' && <p class="notice">{t('koreanNotice')}</p>}
			</header>

			<nav class="tag-nav" aria-label="tags">
				<button type="button" class="tag-chip is-active" data-tag="">
					{allLabel} <span class="tn-count">{posts.length}</span>
				</button>
				{tagList.map(([tag, n]) => (
					<button type="button" class="tag-chip" data-tag={tag}>
						{tag} <span class="tn-count">{n}</span>
					</button>
				))}
			</nav>

			<ul class="post-list">
				{
					posts.map((post) => (
						<li data-tags={post.data.tags.join(' ')}>
							<FormattedDate date={post.data.pubDate} />
							<div class="post-main">
								<a class="post-link" href={localize(`/blog/${post.id}/`, lang)}>
									{pick(post.data.title, post.data.titleEn)}
								</a>
								{pick(post.data.description, post.data.descriptionEn) && (
									<p class="post-desc">{pick(post.data.description, post.data.descriptionEn)}</p>
								)}
								{post.data.project && PROJECT_LABELS[post.data.project] && (
									<a class="post-project" href={localize(`/projects/${post.data.project}/`, lang)}>
										{PROJECT_LABELS[post.data.project]}
									</a>
								)}
							</div>
							{post.data.tags.length > 0 && (
								<ul class="tags post-tags">
									{post.data.tags.map((tag) => (
										<li>
											<button type="button" class="tag blog-tag" data-tag={tag}>{tag}</button>
										</li>
									))}
								</ul>
							)}
						</li>
					))
				}
			</ul>
		</main>
		<Footer />
	</body>
</html>

<script>
	// 뷰 전환 뒤에도 현재 DOM 을 보도록 매번 새로 찾는다.
	function applyFilter(tag: string) {
		let shown = 0;
		for (const li of document.querySelectorAll<HTMLElement>('.post-list > li')) {
			const tags = (li.dataset.tags ?? '').split(' ').filter(Boolean);
			const show = !tag || tags.includes(tag);
			li.hidden = !show;
			if (show) shown++;
		}
		document.querySelectorAll<HTMLElement>('[data-tag]').forEach((el) => {
			el.classList.toggle('is-active', (el.dataset.tag ?? '') === tag);
		});
		const countEl = document.querySelector<HTMLElement>('.post-count');
		if (countEl) {
			countEl.textContent = tag ? `${tag} | ${shown}` : (countEl.dataset.base ?? '');
		}
	}

	document.addEventListener('click', (e) => {
		const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-tag]');
		if (!btn) return;
		e.preventDefault();
		applyFilter(btn.dataset.tag ?? '');
		if (btn.classList.contains('blog-tag')) {
			document.querySelector('.tag-nav')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
		}
	});
</script>

<style>
	.page-head {
		padding-top: 1.5rem;
	}
	.page-head h1 {
		margin-bottom: 0.2rem;
	}
	.post-count,
	.notice {
		font-size: 0.86rem;
		color: rgb(var(--gray));
		margin: 0;
	}
	.notice {
		margin-top: 0.3rem;
	}

	/* ---- 태그 필터: 정사각 칩 ---- */
	.tag-nav {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin: 2rem 0 0;
		padding: 1rem 0;
		border-top: 1px solid var(--line);
		border-bottom: 1px solid var(--line);
		scroll-margin-top: calc(var(--header-h) + 1rem);
	}
	.tag-chip {
		font-family: inherit;
		font-size: 0.78rem;
		line-height: 1.5;
		padding: 0.25em 0.65em;
		border: 1px solid var(--line);
		background: none;
		color: rgb(var(--gray-dark));
		cursor: pointer;
	}
	.tag-chip .tn-count {
		color: rgb(var(--gray));
		margin-left: 0.2em;
	}
	.tag-chip:hover {
		border-color: rgb(var(--gray-dark));
	}
	.tag-chip.is-active {
		border-color: var(--accent);
		color: var(--accent);
	}
	.tag-chip.is-active .tn-count {
		color: inherit;
	}

	/* ---- 글 행: 날짜 | 제목 + 설명 | 태그 ---- */
	.post-list {
		list-style: none;
		padding: 0;
		margin: 0;
	}
	.post-list > li {
		display: grid;
		grid-template-columns: 8.5rem minmax(0, 1fr) 13rem;
		gap: 1rem 2rem;
		align-items: baseline;
		padding: 1.5rem 0;
	}
	.post-list > li + li {
		border-top: 1px solid var(--line-soft);
	}
	.post-list > li[hidden] {
		display: none;
	}
	.post-list > li > :global(time) {
		font-size: 0.86rem;
		color: rgb(var(--gray));
		white-space: nowrap;
	}
	.post-link {
		font-family: var(--font-display);
		font-size: 1.22rem;
		font-weight: 700;
		letter-spacing: -0.02em;
		line-height: 1.4;
		color: rgb(var(--black));
		text-decoration: none;
	}
	.post-link:hover {
		color: var(--accent);
	}
	.post-desc {
		color: rgb(var(--gray-dark));
		font-size: 0.93rem;
		line-height: 1.65;
		max-width: 68ch;
		margin: 0.45rem 0 0;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.post-project {
		display: inline-block;
		margin-top: 0.5rem;
		font-size: 0.82rem;
		color: rgb(var(--gray));
		text-decoration: none;
	}
	.post-project::before {
		content: '@ ';
	}
	.post-project:hover {
		color: var(--accent);
	}
	.post-tags {
		justify-content: flex-end;
	}
	.blog-tag {
		cursor: pointer;
		font-size: 0.7rem;
	}
	.blog-tag.is-active {
		border-color: var(--accent);
		color: var(--accent);
	}

	@media (max-width: 860px) {
		.post-list > li {
			grid-template-columns: 8.5rem minmax(0, 1fr);
		}
		.post-tags {
			grid-column: 2;
			justify-content: flex-start;
		}
	}
	@media (max-width: 600px) {
		.post-list > li {
			grid-template-columns: 1fr;
			gap: 0.4rem;
		}
		.post-tags {
			grid-column: auto;
			margin-top: 0.3rem;
		}
	}
</style>
