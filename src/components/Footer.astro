---
import { PROFILE } from '../consts';
const year = new Date().getFullYear();
---

<footer>
	<div class="inner">
		<p>&copy; {year} {PROFILE.name} ({PROFILE.nameEn})</p>
		<div class="links">
			<a href={`mailto:${PROFILE.email}`}>Email</a>
			<a href={PROFILE.github} target="_blank" rel="noopener">GitHub</a>
			<a href={PROFILE.instagram} target="_blank" rel="noopener">Instagram</a>
		</div>
	</div>
</footer>
<style>
	footer {
		margin-top: 5rem;
		padding: 1.75rem var(--gutter) 3rem;
		border-top: 1px solid var(--line-soft);
		color: rgb(var(--gray));
		font-size: 0.85rem;
	}
	.inner {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem 2rem;
		max-width: var(--wrap);
		margin: 0 auto;
	}
	p {
		margin: 0;
	}
	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 1.25rem;
	}
	.links a {
		color: rgb(var(--gray));
		text-decoration: none;
	}
	.links a:hover {
		color: var(--accent);
	}
</style>
