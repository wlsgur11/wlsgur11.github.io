---
import { NAV, PROFILE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import { getLang, localize, togglePath, languages } from '../i18n';

const lang = getLang(Astro.url);
const alt = togglePath(Astro.url.pathname);
const altLabel = lang === 'ko' ? languages.en : languages.ko;
---

<header class="site-header">
	<nav>
		<a class="brand" href={localize('/', lang)}
			><img class="brand-mark" src="/images/moon-64.png" width="22" height="22" alt="" />{PROFILE.name}</a
		>
		<div class="internal-links">
			{NAV.map((item) => <HeaderLink href={localize(item.href, lang)}>{item.label}</HeaderLink>)}
		</div>
		<div class="right">
			<a class="lang" href={alt} aria-label="language">{altLabel}</a>
			<button id="theme-toggle" class="theme-toggle" type="button" aria-label="테마 전환">dark</button>
			<a class="gh" href={PROFILE.github} target="_blank" rel="noopener">
				<span class="sr-only">GitHub</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="20" height="20"
					><path
						fill="currentColor"
						d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
					></path></svg
				>
			</a>
		</div>
	</nav>
</header>
<script>
	function initThemeToggle() {
		const btn = document.getElementById('theme-toggle');
		if (!btn) return;
		const prefersDark = () => window.matchMedia('(prefers-color-scheme: dark)').matches;
		const isDark = () => {
			const t = document.documentElement.dataset.theme;
			return t ? t === 'dark' : prefersDark();
		};
		// 버튼 글자는 눌렀을 때 바뀔 모드
		const sync = () => {
			btn.textContent = isDark() ? 'light' : 'dark';
		};
		btn.addEventListener('click', () => {
			const next = isDark() ? 'light' : 'dark';
			document.documentElement.dataset.theme = next;
			localStorage.setItem('theme', next);
			sync();
		});
		sync();
	}
	// 초기 로드 + 뷰 전환 후마다 재바인딩
	document.addEventListener('astro:page-load', initThemeToggle);
</script>
<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 10;
		height: var(--header-h);
		padding: 0 var(--gutter);
		background: var(--page-bg);
		border-bottom: 1px solid var(--line);
	}
	nav {
		display: flex;
		align-items: center;
		gap: 1.5rem;
		height: 100%;
		max-width: var(--wrap);
		margin: 0 auto;
	}
	.brand {
		font-family: var(--font-display);
		font-weight: 800;
		font-size: 1.15rem;
		letter-spacing: -0.02em;
		color: rgb(var(--black));
		text-decoration: none;
		white-space: nowrap;
		margin-right: auto;
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
	}
	.brand-mark {
		display: block;
		flex: none;
	}
	.internal-links {
		display: flex;
		gap: 1.25rem;
	}
	.internal-links :global(a) {
		font-size: 0.94rem;
		color: rgb(var(--gray-dark));
		text-decoration: none;
	}
	.internal-links :global(a:hover) {
		color: rgb(var(--black));
	}
	.right {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding-left: 1.25rem;
		border-left: 1px solid var(--line);
	}
	.lang,
	.theme-toggle {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		line-height: 1;
		padding: 0.45em 0.6em;
		border: 1px solid var(--line);
		background: none;
		color: rgb(var(--gray-dark));
		text-decoration: none;
		cursor: pointer;
		white-space: nowrap;
	}
	.theme-toggle {
		min-width: 6ch;
	}
	.lang:hover,
	.theme-toggle:hover {
		border-color: var(--accent);
		color: var(--accent);
	}
	.gh {
		display: flex;
		align-items: center;
		color: rgb(var(--gray-dark));
		padding: 0.25rem;
	}
	.gh:hover {
		color: var(--accent);
	}
	@media (max-width: 720px) {
		nav {
			gap: 0.9rem;
		}
		.internal-links {
			gap: 0.8rem;
		}
		.right {
			padding-left: 0.8rem;
			gap: 0.4rem;
		}
		.gh {
			display: none;
		}
	}
	@media (max-width: 400px) {
		.brand {
			font-size: 1rem;
		}
		.internal-links :global(a) {
			font-size: 0.88rem;
		}
		.internal-links {
			gap: 0.65rem;
		}
		.right {
			border-left: none;
			padding-left: 0;
		}
	}
</style>
