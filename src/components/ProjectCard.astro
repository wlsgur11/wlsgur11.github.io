---
// 실서비스 카드: 화면 캡처(16:10) + 이름 + 한 줄 설명 + 역할 + 큰 숫자 하나 + 기술 + 링크.
// 홈(#projects)과 /projects 주요 그룹이 같이 쓴다. bullets 는 /projects 에서만 켠다.
import type { CollectionEntry } from 'astro:content';
import { type Lang, localize, useTranslations } from '../i18n';

interface Props {
	p: CollectionEntry<'projects'>;
	lang: Lang;
	bullets?: boolean;
}
const { p, lang, bullets = false } = Astro.props;
const t = useTranslations(lang);
const en = lang === 'en';
const pick = (ko: string, e?: string) => (en && e ? e : ko);
const d = p.data;
const href = localize(`/projects/${p.id}/`, lang);
// 제목 'Code Place - 부산대 온라인 저지 플랫폼' 을 이름과 한 줄 설명으로 나눈다
const [name, ...rest] = pick(d.title, d.titleEn).split(' - ');
const line = rest.join(' - ');
const h = d.highlight;
const period = en ? d.period.replace('진행 중', 'present') : d.period;
const summary = en && d.summaryEn.length ? d.summaryEn : d.summary;
---

<article class="pc" data-reveal>
	{
		d.cover && (
			<a class="pc-cover" href={href} tabindex="-1" aria-hidden="true">
				<img src={d.cover} alt="" width="800" height="500" loading="lazy" decoding="async" />
			</a>
		)
	}
	<div class="pc-body">
		<h3><a href={href}>{name}</a></h3>
		{line && <p class="pc-line">{line}</p>}
		<p class="pc-role">{pick(d.role, d.roleEn)} | {period}</p>
		{
			h && (
				<div class="pc-stat">
					<span class="pc-fig">
						<span class="pc-num">{h.value}</span>
						{!en && h.unit && <span class="pc-unit">{h.unit}</span>}
					</span>
					<span class="pc-txt">
						<span class="pc-label">{pick(h.label, h.labelEn)}</span>
						{h.sub && <span class="pc-sub">{pick(h.sub, h.subEn)}</span>}
					</span>
				</div>
			)
		}
		{
			bullets && summary.length > 0 && (
				<ul class="pc-bullets">
					{summary.map((b) => (
						<li>{b}</li>
					))}
				</ul>
			)
		}
		<ul class="tags pc-tags">
			{d.stack.slice(0, 6).map((s) => <li class="tag">{s}</li>)}
		</ul>
		<div class="pc-links">
			{
				d.links.live && (
					<a href={d.links.live} target="_blank" rel="noopener">
						Live ↗
					</a>
				)
			}
			<a class="pc-more" href={href}>{t('viewDetail')}</a>
		</div>
	</div>
</article>

<style>
	.pc {
		display: flex;
		flex-direction: column;
		border: 1px solid var(--line);
		background: var(--page-bg);
	}
	.pc:hover {
		border-color: var(--accent);
	}
	.pc-cover {
		display: block;
		aspect-ratio: 16 / 10;
		overflow: hidden;
		background: var(--surface);
		border-bottom: 1px solid var(--line);
	}
	.pc-cover img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: top;
	}
	.pc-body {
		display: flex;
		flex-direction: column;
		flex: 1;
		min-width: 0;
		padding: 1.3rem 1.4rem 1.2rem;
	}
	h3 {
		font-size: 1.45rem;
		font-weight: 800;
		margin: 0;
	}
	h3 a {
		color: inherit;
		text-decoration: none;
	}
	.pc:hover h3 a {
		color: var(--accent);
	}
	.pc-line {
		margin: 0.2rem 0 0;
		font-size: 0.98rem;
		line-height: 1.5;
		color: rgb(var(--gray-dark));
	}
	.pc-role {
		margin: 0.45rem 0 0;
		font-size: 0.84rem;
		line-height: 1.5;
		color: rgb(var(--gray));
	}

	/* 큰 숫자 카드 (PPT 문법): 왼쪽 굵은 띠 + 숫자 + 단위 | 라벨 + 보조 한 줄 */
	.pc-stat {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		align-items: center;
		gap: 0.4rem 1.1rem;
		margin: 1.1rem 0 0;
		padding: 0.85rem 1rem;
		background: var(--surface);
		border-left: 3px solid var(--accent);
	}
	.pc-fig {
		display: flex;
		align-items: baseline;
		gap: 0.2rem;
		white-space: nowrap;
	}
	.pc-num {
		font-family: var(--font-mono);
		font-weight: 700;
		font-size: 2.1rem;
		line-height: 1;
		letter-spacing: -0.03em;
		color: var(--accent);
		font-variant-numeric: tabular-nums;
	}
	.pc-unit {
		font-size: 1rem;
		font-weight: 700;
		color: rgb(var(--black));
	}
	.pc-txt {
		display: flex;
		flex-direction: column;
		min-width: 0;
		line-height: 1.4;
	}
	.pc-label {
		font-weight: 700;
		font-size: 0.95rem;
		color: rgb(var(--black));
	}
	.pc-sub {
		font-size: 0.82rem;
		color: rgb(var(--gray-dark));
	}

	.pc-bullets {
		margin: 1rem 0 0;
		padding-left: 1.1em;
		display: flex;
		flex-direction: column;
		gap: 0.35em;
	}
	.pc-bullets li {
		font-size: 0.92rem;
		line-height: 1.6;
	}
	.pc-tags {
		margin-top: 1rem;
	}
	.pc-links {
		display: flex;
		align-items: center;
		gap: 1.1rem;
		margin-top: auto;
		padding-top: 1.1rem;
		font-size: 0.88rem;
		font-weight: 600;
	}
	.pc-links a {
		color: rgb(var(--gray-dark));
		text-decoration: none;
	}
	.pc-links a:hover {
		color: var(--accent);
	}
	.pc-links .pc-more {
		margin-left: auto;
		color: var(--accent);
	}

	@media (max-width: 420px) {
		.pc-body {
			padding: 1.1rem 1rem 1rem;
		}
		.pc-num {
			font-size: 1.8rem;
		}
	}
</style>
