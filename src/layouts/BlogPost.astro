---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { PROJECT_LABELS } from '../consts';
import { type Lang, localize, useTranslations } from '../i18n';

type Props = CollectionEntry<'blog'>['data'] & { lang?: Lang };

const {
	title,
	titleEn,
	description,
	descriptionEn,
	pubDate,
	updatedDate,
	heroImage,
	tags = [],
	project,
	lang = 'ko',
} = Astro.props;
const t = useTranslations(lang);
const displayTitle = lang === 'en' && titleEn ? titleEn : title;
const displayDesc = lang === 'en' && descriptionEn ? descriptionEn : description;
const projectLabel = project ? PROJECT_LABELS[project] : undefined;
---

<html lang={lang}>
	<head>
		<BaseHead title={displayTitle} description={displayDesc} />
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: var(--radius);
				box-shadow: var(--box-shadow);
			}
			.prose {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
			}
			.title {
				margin-bottom: 1.6em;
				padding: 1.5em 0 1em;
				text-align: left;
			}
			.meta-line {
				display: flex;
				align-items: center;
				flex-wrap: wrap;
				gap: 0.5em;
				font-family: var(--font-mono);
				font-size: 0.8em;
				margin-bottom: 0.9em;
				color: rgb(var(--gray));
			}
			.meta-line .sep {
				opacity: 0.5;
			}
			.proj-link {
				display: inline-flex;
				align-items: center;
				gap: 0.4em;
				color: var(--accent);
				text-decoration: none;
			}
			.proj-link::before {
				content: '';
				width: 5px;
				height: 5px;
				border-radius: 50%;
				background: var(--accent);
				opacity: 0.7;
			}
			.proj-link:hover {
				text-decoration: underline;
			}
			.last-updated-on {
				font-style: italic;
			}
			.post-tags {
				margin: 1.1em 0 0;
			}
			.notice {
				font-size: 0.85em;
				color: rgb(var(--gray));
				margin: 0.9em 0 0;
			}
			.title hr {
				margin: 1.2em 0 0;
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<div class="hero-image">
					{heroImage && <Image width={1020} height={510} src={heroImage} alt="" />}
				</div>
				<div class="prose">
					<div class="title">
						<div class="meta-line">
							<FormattedDate date={pubDate} />
							{projectLabel && (
								<>
									<span class="sep">·</span>
									<a class="proj-link" href={localize(`/projects/${project}/`, lang)}>{projectLabel}</a>
								</>
							)}
							{updatedDate && (
								<span class="last-updated-on">
									· Last updated {<FormattedDate date={updatedDate} />}
								</span>
							)}
						</div>
						<h1>{displayTitle}</h1>
						{tags.length > 0 && (
							<ul class="tags post-tags">
								{tags.map((tag) => (
									<li class="tag">{tag}</li>
								))}
							</ul>
						)}
						{lang === 'en' && t('koreanNotice') && <p class="notice">{t('koreanNotice')}</p>}
						<hr />
					</div>
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
