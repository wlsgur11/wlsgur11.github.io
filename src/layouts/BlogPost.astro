---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { PROJECT_LABELS, tabTitle } from '../consts';
import { type Lang, localize, useTranslations } from '../i18n';

type Props = CollectionEntry<'blog'>['data'] & { lang?: Lang };

const {
	title,
	titleEn,
	description,
	descriptionEn,
	pubDate,
	updatedDate,
	heroImage,
	tags = [],
	project,
	lang = 'ko',
} = Astro.props;
const t = useTranslations(lang);
const displayTitle = lang === 'en' && titleEn ? titleEn : title;
const displayDesc = lang === 'en' && descriptionEn ? descriptionEn : description;
const projectLabel = project ? PROJECT_LABELS[project] : undefined;
---

<html lang={lang}>
	<head>
		<BaseHead title={tabTitle(title)} description={displayDesc} />
	</head>

	<body>
		<Header />
		<div class="read-progress" data-read-progress aria-hidden="true"></div>
		<main data-enter>
			<article class="post" data-article>
				{heroImage && (
					<div class="hero-image">
						<Image width={1020} height={510} src={heroImage} alt="" />
					</div>
				)}
				<header class="title">
					<h1>{displayTitle}</h1>
					<div class="meta-line">
						<FormattedDate date={pubDate} />
						{updatedDate && (
							<span class="last-updated-on">
								<span class="sep">|</span> Last updated <FormattedDate date={updatedDate} />
							</span>
						)}
						{projectLabel && (
							<>
								<span class="sep">|</span>
								<a class="proj-link" href={localize(`/projects/${project}/`, lang)}>{projectLabel}</a>
							</>
						)}
					</div>
					{tags.length > 0 && (
						<ul class="tags post-tags">
							{tags.map((tag) => (
								<li class="tag">{tag}</li>
							))}
						</ul>
					)}
					{lang === 'en' && t('koreanNotice') && <p class="notice">{t('koreanNotice')}</p>}
				</header>
				<div class="prose">
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
	.read-progress {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 20;
		height: 2px;
		background: var(--accent);
		transform: scaleX(0);
		transform-origin: 0 50%;
		pointer-events: none;
	}
	.post {
		max-width: 68ch;
		margin: 0 auto;
	}
	.hero-image img {
		display: block;
		width: 100%;
		margin: 0 0 2rem;
		border: 1px solid var(--line-soft);
	}
	.title {
		padding: 1rem 0 1.75rem;
		margin-bottom: 2.25rem;
		border-bottom: 1px solid var(--line);
	}
	.title h1 {
		font-size: clamp(1.7rem, 1.35rem + 1.4vw, 2.1rem);
		line-height: 1.3;
		margin: 0 0 1rem;
		text-wrap: balance;
	}
	.meta-line {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.4rem 0.6rem;
		font-size: 0.86rem;
		color: rgb(var(--gray));
		font-variant-numeric: tabular-nums;
	}
	.sep {
		color: var(--line);
	}
	.proj-link {
		color: rgb(var(--gray-dark));
		text-decoration: none;
	}
	.proj-link:hover {
		color: var(--accent);
	}
	.post-tags {
		margin-top: 0.7rem;
	}
	.post-tags .tag {
		font-size: 0.7rem;
	}
	.notice {
		font-size: 0.85rem;
		color: rgb(var(--gray));
		margin: 1rem 0 0;
	}
</style>
