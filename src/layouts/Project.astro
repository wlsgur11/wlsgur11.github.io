---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { type Lang, highlightHtml, useTranslations } from '../i18n';
import { tabTitle } from '../consts';

type Props = CollectionEntry<'projects'>['data'] & { lang?: Lang };

const {
	title,
	titleEn,
	description,
	descriptionEn,
	role,
	roleEn,
	period,
	stack,
	links,
	cover,
	highlight,
	summary,
	summaryEn,
	lang = 'ko',
} = Astro.props;
const t = useTranslations(lang);
const en = lang === 'en';
const pick = (ko: string, e?: string) => (en && e ? e : ko);
// 요약 불릿: 대표 수치 문장 + summary[1..] (summary[0] 은 위 설명 문단과 겹친다)
const hl = highlightHtml(highlight, lang);
const points = (en && summaryEn.length ? summaryEn : summary).slice(1);
---

<html lang={lang}>
	<head>
		<BaseHead title={tabTitle(title)} description={pick(description, descriptionEn)} />
	</head>
	<body>
		<Header />
		<main data-enter>
			<article class="project">
				<header class="project-head">
					<p class="meta-line num">
						{en ? period.replace('진행 중', 'present') : period} <span class="sep">|</span> {pick(role, roleEn)}
					</p>
					<h1>{pick(title, titleEn)}</h1>
					<p class="lead">{pick(description, descriptionEn)}</p>
					{
						(hl || points.length > 0) && (
							<ul class="points">
								{hl && <li set:html={hl} />}
								{points.map((b) => (
									<li>{b}</li>
								))}
							</ul>
						)
					}
					<p class="stack">{stack.join(', ')}</p>
					{
						(links.repo || links.live) && (
							<p class="links">
								{links.live && (
									<a href={links.live} target="_blank" rel="noopener">
										Live ↗
									</a>
								)}
								{links.repo && (
									<a href={links.repo} target="_blank" rel="noopener">
										Repository ↗
									</a>
								)}
							</p>
						)
					}
					{en && t('koreanNotice') && <p class="notice">{t('koreanNotice')}</p>}
				</header>
				{
					cover && (
						<figure class="proj-cover">
							<img src={cover} alt="" width="800" height="500" />
						</figure>
					)
				}
				<div class="prose">
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
	.project {
		max-width: 68ch;
		margin: 0 auto;
	}
	.project-head {
		padding: 1rem 0 0;
	}
	.meta-line {
		font-size: 0.86rem;
		color: rgb(var(--gray));
		margin: 0 0 0.5rem;
	}
	.sep {
		color: var(--line);
	}
	.project-head h1 {
		font-size: clamp(1.7rem, 1.35rem + 1.4vw, 2.1rem);
		line-height: 1.3;
		margin: 0 0 0.8rem;
		text-wrap: balance;
	}
	.lead {
		font-size: 1.05rem;
		margin: 0 0 1rem;
	}
	.points {
		margin: 0 0 1rem;
		padding-left: 1.1em;
	}
	.points li {
		margin-bottom: 0.3rem;
	}
	.points li::marker {
		color: rgb(var(--gray));
	}
	.points :global(strong) {
		color: rgb(var(--black));
	}
	.stack {
		margin: 0;
		font-size: 0.88rem;
		color: rgb(var(--gray));
	}
	.links {
		display: flex;
		gap: 1.5rem;
		margin: 0.75rem 0 0;
		font-size: 0.9rem;
		font-weight: 600;
	}
	.links a {
		color: rgb(var(--gray-dark));
		text-decoration: none;
	}
	.links a:hover {
		color: var(--accent);
	}
	.notice {
		font-size: 0.85rem;
		color: rgb(var(--gray));
		margin: 1rem 0 0;
	}
	/* 화면 캡처 하나: 본문 앞, 1px 테두리. 로고 이미지도 잘리지 않게 contain */
	.proj-cover {
		margin: 2rem 0 0;
		aspect-ratio: 16 / 10;
		background: var(--surface);
		border: 1px solid var(--line);
	}
	.proj-cover img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: contain;
	}
	.prose {
		margin-top: 2.25rem;
		padding-top: 2rem;
		border-top: 1px solid var(--line);
	}
</style>
